func load_config(settings) {
	result := {
		"settings": settings,
		"errors": []
	}

	config_path := ""
	if path_exists("kujo-ssg.yml") {
		config_path := "kujo-ssg.yml"
	} else if path_exists("kujo-ssg.yaml") {
		config_path := "kujo-ssg.yaml"
	} else if path_exists("kujo-ssg.json") {
		config_path := "kujo-ssg.json"
	}

	if len(config_path) == 0 {
		return result
	}

	try {
		raw := read_file(config_path)
		parsed := {}
		if ends_with(config_path, ".json") {
			parsed := parse_json(raw)
		} else {
			parsed := parse_yaml(raw)
		}
		if is_dict(parsed) {
			parsed_keys := keys(parsed)
			parsed_key_idx := 0
			loop {
				if parsed_key_idx >= len(parsed_keys) {
					break
				}

				key := parsed_keys[parsed_key_idx]
				parsed_key_idx := parsed_key_idx + 1
				settings[key] = parsed[key]
			}
		} else {
			result["errors"] = push(result["errors"], "Could not parse " + config_path + ": expected a top-level object")
		}
		print("Loaded configuration from " + config_path)
	} except err {
		result["errors"] = push(result["errors"], "Could not parse " + config_path + ": " + safe_error_text(err))
	}

	result["settings"] = settings
	return result
}

func apply_cli_overrides(settings, cli_args) {
	result := {
		"settings": settings,
		"show_help": false,
		"show_version": false,
		"init_format": "",
		"errors": []
	}

	i := 0
	loop {
		if i >= len(cli_args) {
			break
		}

		token := cli_args[i]

		if token == "--help" || token == "-h" {
			result["show_help"] = true
			i := i + 1
			continue
		}
		if token == "--version" {
			result["show_version"] = true
			i := i + 1
			continue
		}
		if token == "--watch" {
			settings["watch"] = true
			i := i + 1
			continue
		}
		if token == "--minify" {
			settings["minify"] = true
			i := i + 1
			continue
		}
		if token == "--download-remote-images" {
			settings["download_remote_images"] = true
			i := i + 1
			continue
		}
		if token == "--drafts" {
			settings["drafts"] = true
			i := i + 1
			continue
		}
		if token == "--posts-at-root" {
			settings["posts_at_root"] = true
			i := i + 1
			continue
		}
		if token == "--no-index" {
			settings["no_index"] = true
			i := i + 1
			continue
		}
		if token == "--no-aux" {
			settings["no_aux"] = true
			i := i + 1
			continue
		}
		if token == "--no-aliases" {
			settings["no_aliases"] = true
			i := i + 1
			continue
		}

		value_flags := [
			{"flag": "--output", "key": "output"},
			{"flag": "--content", "key": "content"},
			{"flag": "--templates", "key": "templates"},
			{"flag": "--assets", "key": "assets"},
			{"flag": "--posts-per-page", "key": "posts_per_page"},
			{"flag": "--sort-by", "key": "sort_by"},
			{"flag": "--fonts", "key": "fonts"},
			{"flag": "--site-title", "key": "site_title"},
			{"flag": "--site-tagline", "key": "site_tagline"},
			{"flag": "--site-url", "key": "site_url"},
			{"flag": "--robots", "key": "robots"},
			{"flag": "--llms", "key": "llms"},
			{"flag": "--blog-slug", "key": "blog_slug"},
			{"flag": "--phase", "key": "phase"},
			{"flag": "--shard", "key": "shard"},
			{"flag": "--shards", "key": "shards"},
			{"flag": "--init", "key": "init"}
		]

		matched := false
		value_flag_idx := 0
		loop {
			if value_flag_idx >= len(value_flags) {
				break
			}

			spec := value_flags[value_flag_idx]
			value_flag_idx := value_flag_idx + 1
			flag := spec["flag"]
			key := spec["key"]
			value := ""

			if token == flag {
				matched := true
				if i + 1 < len(cli_args) {
					value := cli_args[i + 1]
					i := i + 1
				} else {
					result["errors"] = push(result["errors"], "Missing value for " + flag)
				}
			} else {
				inline := option_inline_value(token, flag)
				if inline != null {
					value := inline
					matched := true
				}
			}

			if matched {
				value := trim(to_string(value))
				if len(value) == 0 {
					result["errors"] = push(result["errors"], "Missing value for " + flag)
					break
				}

				if key == "init" {
					init_format := to_lower(value)
					if !string_in_list(init_format, ["yml", "yaml", "json"]) {
						result["errors"] = push(result["errors"], "Invalid value for --init: " + value + " (expected yml, yaml, or json)")
					} else {
						result["init_format"] = init_format
					}
				} else if key == "fonts" {
					settings["fonts"] = to_string_array(value)
				} else {
					settings[key] = value
				}
				break
			}
		}

		if !matched {
			if starts_with(token, "-") {
				result["errors"] = push(result["errors"], "Unknown option: " + token)
			} else {
				result["errors"] = push(result["errors"], "Unexpected argument: " + token)
			}
		}

		i := i + 1
	}

	result["settings"] = settings
	return result
}

func normalize_settings(settings) {
	result := {
		"settings": settings,
		"errors": []
	}

	settings["output"] = trim(to_string(settings["output"]))
	settings["content"] = trim(to_string(settings["content"]))
	settings["templates"] = trim(to_string(settings["templates"]))
	settings["assets"] = trim(to_string(settings["assets"]))
	settings["site_title"] = trim(to_string(settings["site_title"]))
	settings["site_tagline"] = trim(to_string(settings["site_tagline"]))
	settings["site_url"] = trim(to_string(settings["site_url"]))
	settings["blog_slug"] = clean_slug(to_string(settings["blog_slug"]))

	raw_posts_per_page := settings["posts_per_page"]
	settings["posts_per_page"] = parse_int_value(raw_posts_per_page, 5)
	if !is_integer_text(raw_posts_per_page) || settings["posts_per_page"] <= 0 {
		result["errors"] = push(result["errors"], "Invalid value for posts_per_page: " + to_string(raw_posts_per_page) + " (expected positive integer)")
	}
	if settings["posts_per_page"] <= 0 {
		settings["posts_per_page"] = 5
	}

	sort_by := to_lower(trim(to_string(settings["sort_by"])))
	if len(sort_by) > 0 && !string_in_list(sort_by, ["date", "title", "author", "order"]) {
		result["errors"] = push(result["errors"], "Invalid value for sort_by: " + to_string(settings["sort_by"]) + " (expected date, title, author, or order)")
	}
	if !string_in_list(sort_by, ["date", "title", "author", "order"]) {
		sort_by := "date"
	}
	settings["sort_by"] = sort_by

	bool_specs := [
		{"key": "watch", "fallback": false},
		{"key": "minify", "fallback": false},
		{"key": "download_remote_images", "fallback": false},
		{"key": "drafts", "fallback": false},
		{"key": "posts_at_root", "fallback": false},
		{"key": "no_index", "fallback": false},
		{"key": "no_aux", "fallback": false},
		{"key": "no_aliases", "fallback": false}
	]
	bool_index := 0
	loop {
		if bool_index >= len(bool_specs) {
			break
		}

		spec := bool_specs[bool_index]
		key := spec["key"]
		fallback := spec["fallback"]
		raw_value := settings[key]
		if !is_valid_bool_input(raw_value) {
			result["errors"] = push(result["errors"], "Invalid boolean value for " + key + ": " + to_string(raw_value))
		}
		settings[key] = parse_bool_value(raw_value, fallback)

		bool_index := bool_index + 1
	}

	fonts := settings["fonts"]
	settings["fonts"] = to_string_array(fonts)

	robots := to_lower(trim(to_string(settings["robots"])))
	if len(robots) > 0 && !string_in_list(robots, ["public", "private"]) {
		result["errors"] = push(result["errors"], "Invalid value for robots: " + to_string(settings["robots"]) + " (expected public or private)")
	}
	if !string_in_list(robots, ["public", "private"]) {
		robots := "public"
	}
	settings["robots"] = robots

	llms := to_lower(trim(to_string(settings["llms"])))
	if len(llms) > 0 && !string_in_list(llms, ["public", "private"]) {
		result["errors"] = push(result["errors"], "Invalid value for llms: " + to_string(settings["llms"]) + " (expected public or private)")
	}
	if !string_in_list(llms, ["public", "private"]) {
		llms := "public"
	}
	settings["llms"] = llms

	if len(settings["output"]) == 0 {
		settings["output"] = "output"
	}
	if len(settings["content"]) == 0 {
		settings["content"] = "content"
	}
	if len(settings["templates"]) == 0 {
		settings["templates"] = "templates"
	}
	if len(settings["assets"]) == 0 {
		settings["assets"] = "assets"
	}

	# Phased/sharded build controls (used by the parallel orchestrator). The
	# default "full" phase reproduces the standard single-process build exactly.
	phase := to_lower(trim(to_string(settings["phase"])))
	if len(phase) == 0 {
		phase := "full"
	}
	if !string_in_list(phase, ["full", "setup", "posts", "finalize"]) {
		result["errors"] = push(result["errors"], "Invalid value for phase: " + to_string(settings["phase"]) + " (expected full, setup, posts, or finalize)")
		phase := "full"
	}
	settings["phase"] = phase
	settings["shards"] = parse_int_value(settings["shards"], 1)
	if settings["shards"] < 1 {
		settings["shards"] = 1
	}
	settings["shard"] = parse_int_value(settings["shard"], 0)
	if settings["shard"] < 0 {
		settings["shard"] = 0
	}

	result["settings"] = settings
	return result
}

func copy_assets(settings) {
	output_assets := path_join(settings["output"], "assets")
	ensure_dir(output_assets)

	assets_dir := settings["assets"]
	used_config_assets := false
	if path_exists(assets_dir) && path_is_dir(assets_dir) {
		copy_tree(assets_dir, output_assets)
		used_config_assets := true
	} else if path_exists("static") && path_is_dir("static") {
		copy_tree("static", output_assets)
	}

	static_style := path_join("static", "style.css")
	if !used_config_assets && path_exists(static_style) {
		out_css_dir := path_join(output_assets, "css")
		ensure_dir(out_css_dir)
		copy_file(static_style, path_join(out_css_dir, "style.css"))
	}
}

func build_site(settings) {
	build_start := performance_now()
	output_dir := settings["output"]
	content_root := settings["content"]
	templates_dir := settings["templates"]
	site_url := trim(settings["site_url"])
	if ends_with(site_url, "/") {
		site_url := substring(site_url, 0, len(site_url) - 1)
	}

	# Phase controls. "full" (default) is the standard single-process build.
	# "setup"/"posts"/"finalize" split the work so an orchestrator can render
	# post shards across processes (see scripts/build-parallel.sh).
	phase := settings["phase"]
	shard := settings["shard"]
	shards := settings["shards"]
	do_setup := phase == "full" || phase == "setup"
	do_posts := phase == "full" || phase == "posts"
	do_finalize := phase == "full" || phase == "finalize"

	if do_setup {
		if path_exists(output_dir) {
			delete_tree(output_dir)
		}
		ensure_dir(output_dir)

		copy_assets(settings)
		generate_fonts_css(settings)

		# Generate a lightweight SVG favicon from the site initial.
		favicon_initial := "K"
		favicon_title := trim(to_string(settings["site_title"]))
		if len(favicon_title) > 0 {
			favicon_initial = to_upper(substring(favicon_title, 0, 1))
		}
		favicon_svg := "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect width=\"64\" height=\"64\" rx=\"12\" fill=\"#0f172a\"/><text x=\"32\" y=\"43\" font-family=\"system-ui, sans-serif\" font-size=\"36\" font-weight=\"700\" fill=\"#ffffff\" text-anchor=\"middle\">" + xml_escape(favicon_initial) + "</text></svg>\n"
		write_file(path_join(output_dir, "favicon.svg"), favicon_svg)

		# Write a post-file manifest once. Sharded workers read this instead of
		# re-listing the (potentially huge) posts directory, which avoids both
		# redundant work and filesystem contention when many workers list the
		# same large directory concurrently.
		if phase == "setup" {
			setup_post_files := markdown_files(path_join(content_root, "posts"))
			write_file(path_join(output_dir, ".kujo-post-manifest.txt"), join(setup_post_files, "\n") + "\n")
		}
	}

	if phase == "setup" {
		print_lines(["Setup phase complete", "  Output directory: " + output_dir])
		return null
	}

	ensure_dir(output_dir)

	layout_fallback := "<!DOCTYPE html><html lang=\"{{lang}}\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>{{page_title}}</title><meta name=\"description\" content=\"{{meta_description}}\"><meta name=\"keywords\" content=\"{{seo_keywords}}\"><meta name=\"author\" content=\"{{author_meta}}\">{{canonical_tag}}<meta property=\"og:title\" content=\"{{seo_title}}\"><meta property=\"og:description\" content=\"{{seo_description}}\"><meta property=\"og:url\" content=\"{{og_url}}\"><meta property=\"og:type\" content=\"website\">{{og_image_tag}}<meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"{{seo_title}}\"><meta name=\"twitter:description\" content=\"{{seo_description}}\">{{twitter_image_tag}}<link rel=\"stylesheet\" href=\"{{stylesheet_path}}\"></head><body><a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><header><h1><a href=\"{{home_path}}\">{{site_name}}</a></h1><nav aria-label=\"Primary navigation\"><ul>{{navigation}}</ul></nav></header><main id=\"main-content\">{{content}}</main><footer><p>{{site_tagline}}</p></footer></body></html>"
	post_fallback := "<article><h1>{{title}}</h1>{{featured_image_html}}<p>{{date}} {{author}}</p><div>{{categories_html}}</div><div>{{tags_html}}</div>{{taxonomies_html}}<section>{{body}}</section></article>"
	page_fallback := "<article><h1>{{title}}</h1>{{featured_image_html}}<div>{{categories_html}}</div><div>{{tags_html}}</div>{{taxonomies_html}}<section>{{body}}</section></article>"
	not_found_fallback := "<main id=\"main-content\"><article><h1>Page Not Found</h1><p>The page you requested could not be found.</p></article></main>"

	layout_template := layout_fallback
	post_template := post_fallback
	page_template := page_fallback
	not_found_template := not_found_fallback

	layout_path := path_join(templates_dir, "layout.html")
	post_path := path_join(templates_dir, "post.html")
	page_path := path_join(templates_dir, "page.html")
	not_found_path := path_join(templates_dir, "404.html")

	if path_exists(layout_path) { layout_template = read_file(layout_path) }
	if path_exists(post_path) { post_template = read_file(post_path) }
	if path_exists(page_path) { page_template = read_file(page_path) }
	if path_exists(not_found_path) { not_found_template = read_file(not_found_path) }

	home_listing_template := ""
	home_listing_path := path_join(templates_dir, "page-home.html")
	if path_exists(home_listing_path) {
		home_listing_template = read_file(home_listing_path)
	}

	blog_listing_template := ""
	if len(settings["blog_slug"]) > 0 {
		blog_slug_listing_path := path_join(templates_dir, "page-" + settings["blog_slug"] + ".html")
		if path_exists(blog_slug_listing_path) {
			blog_listing_template = read_file(blog_slug_listing_path)
		}
	}
	if len(blog_listing_template) == 0 {
		blog_listing_path := path_join(templates_dir, "page-blog.html")
		if path_exists(blog_listing_path) {
			blog_listing_template = read_file(blog_listing_path)
		}
	}

	authors_lookup := load_lookup(path_join(content_root, "authors.yml"))
	categories_lookup := load_lookup(path_join(content_root, "categories.yml"))
	tags_lookup := load_lookup(path_join(content_root, "tags.yml"))
	color_lookup := load_lookup(path_join(content_root, "color.yml"))
	locations_lookup := load_lookup(path_join(content_root, "storefronts-location.yml"))
	taxonomy_lookups := load_taxonomy_lookups(content_root)
	reserved_taxonomy_slots := ["categories", "tags", "color", "location"]
	# Custom-taxonomy rendering is only possible if there is a non-core taxonomy
	# lookup, or a given item declares `taxonomies:`. Precompute the cheap half so
	# the per-item hot path can skip the expensive discovery work entirely.
	has_custom_tax_lookups := false
	tax_lookup_keys := keys(taxonomy_lookups)
	tax_lookup_key_idx := 0
	loop {
		if tax_lookup_key_idx >= len(tax_lookup_keys) {
			break
		}
		tax_lk := tax_lookup_keys[tax_lookup_key_idx]
		tax_lookup_key_idx := tax_lookup_key_idx + 1
		if tax_lk != "global:categories" && tax_lk != "global:tags" {
			has_custom_tax_lookups = true
			break
		}
	}

	page_files := markdown_files(path_join(content_root, "pages"))
	# In sharded phases, read the manifest written by setup to avoid every worker
	# re-listing a huge posts directory at once (robustness + less redundant work).
	post_files := []
	if phase == "full" {
		post_files = markdown_files(path_join(content_root, "posts"))
	} else {
		post_manifest := path_join(output_dir, ".kujo-post-manifest.txt")
		if path_exists(post_manifest) {
			manifest_text := trim(read_file(post_manifest))
			if len(manifest_text) > 0 {
				post_files = split(manifest_text, "\n")
			}
		} else {
			post_files = markdown_files(path_join(content_root, "posts"))
		}
	}
	custom_collections := []
	if path_exists(content_root) && path_is_dir(content_root) {
		content_entries := sort(list_dir(content_root))
		content_entry_idx := 0
		loop {
			if content_entry_idx >= len(content_entries) {
				break
			}

			entry := content_entries[content_entry_idx]
			content_entry_idx := content_entry_idx + 1
			collection_path := path_join(content_root, entry)
			if !path_is_dir(collection_path) {
				continue
			}
			if entry == "pages" || entry == "posts" {
				continue
			}
			if starts_with(entry, ".") {
				continue
			}

			collection_files := markdown_files(collection_path)
			if len(collection_files) == 0 {
				continue
			}

			collection_slug := clean_slug(entry)
			collection_title := taxonomy_label(collection_slug)
			custom_collections = push(custom_collections, {
				"name": entry,
				"slug": collection_slug,
				"title": collection_title,
				"route": collection_slug + "/",
				"files": collection_files
			})
		}
	}

	pages_data := []
	page_file_idx := 0
	loop {
		if page_file_idx >= len(page_files) {
			break
		}

		page_file := page_files[page_file_idx]
		page_file_idx := page_file_idx + 1
		parsed := parse_frontmatter(read_file(page_file))
		meta := parsed["meta"]
		if !settings["drafts"] && parse_bool_value(meta["draft"], false) {
			continue
		}
		base_name := replace(basename(page_file), ".md", "")
		slug := clean_slug(base_name)
		override_slug := custom_slug_override(meta)
		if len(override_slug) > 0 {
			slug := override_slug
		}
		title := trim(to_string(meta["title"]))
		if len(title) == 0 {
			title := base_name
		}
		description := trim(to_string(meta["description"]))
		if len(description) == 0 {
			description := settings["site_tagline"]
		}
		keywords := trim(to_string(meta["keywords"]))
		seo_title := trim(to_string(meta["seo_title"]))
		seo_description := trim(to_string(meta["seo_description"]))
		if len(seo_description) == 0 {
			seo_description = description
		}
		lang := trim(to_string(meta["lang"]))
		if len(lang) == 0 {
			lang = "en"
		}
		canonical := trim(to_string(meta["canonical"]))
		featured_image := trim(to_string(meta["featured_image"]))
		author_name := resolve_lookup(meta["author"], authors_lookup, "")
		page_categories := meta_terms(meta, "categories", categories_lookup)
		page_tags := meta_terms(meta, "tags", tags_lookup)
		page_custom_taxonomies_html := custom_taxonomies_html(meta, "pages", taxonomy_lookups, reserved_taxonomy_slots, has_custom_tax_lookups)
		pages_data = push(pages_data, {
			"title": title,
			"slug": slug,
			"route": slug + "/",
			"source_file": page_file,
			"description": description,
			"keywords": keywords,
			"seo_title": seo_title,
			"seo_description": seo_description,
			"lang": lang,
			"canonical": canonical,
			"featured_image": featured_image,
			"author": author_name,
			"categories": page_categories,
			"tags": page_tags,
			"taxonomies_html": page_custom_taxonomies_html,
			"body": parsed["body"],
			"template": trim(to_string(meta["template"])),
			"nav_hide": parse_bool_value(meta["nav_hide"], false),
			"date": trim(to_string(meta["date"]))
		})
	}

	# Sitemap is built incrementally as a string (O(n)) instead of accumulating
	# a routes array (O(n^2) under copy-on-write).
	blog_prefix := ""
	if len(settings["blog_slug"]) > 0 {
		blog_prefix := settings["blog_slug"] + "/"
	}
	want_sitemap := !settings["no_aux"] && len(site_url) > 0
	# Flat .html redirect aliases are an extra (the reference SSG emits only clean
	# dir/index.html). On large sites they double per-page write I/O, so they can be
	# turned off with --no-aliases; default keeps them for clean-URL convenience.
	make_aliases := !settings["no_aliases"]
	# Large accumulators are streamed to temp files: both array push and string
	# concatenation are O(n^2) in Kujo, but file append is O(1). In sharded mode
	# each posts worker writes its own records/sitemap temp files, which the
	# finalize phase reads back and merges.
	sitemap_tmp := path_join(output_dir, ".kujo-sitemap.tmp")
	records_tmp := path_join(output_dir, ".kujo-post-index.tmp")
	if phase == "posts" {
		records_tmp = path_join(output_dir, ".kujo-records-" + to_string(shard) + ".tmp")
		sitemap_tmp = path_join(output_dir, ".kujo-sitemap-posts-" + to_string(shard) + ".tmp")
	} else if phase == "finalize" {
		sitemap_tmp = path_join(output_dir, ".kujo-sitemap-final.tmp")
	}
	if path_exists(sitemap_tmp) {
		delete_file(sitemap_tmp)
	}
	if path_exists(records_tmp) {
		delete_file(records_tmp)
	}

	built_pages := []
	storefront_preview_cards := ""
	location_preview_cards := ""
	page_data_idx := 0
	loop {
		if page_data_idx >= len(pages_data) || !do_finalize {
			break
		}

		page_data := pages_data[page_data_idx]
		page_data_idx := page_data_idx + 1
		selected_page_template := page_template
		custom_template_name := page_data["template"]
		if len(custom_template_name) > 0 {
			custom_page_template := path_join(templates_dir, "page-" + custom_template_name + ".html")
			if path_exists(custom_page_template) {
				selected_page_template := read_file(custom_page_template)
			}
		}
		processed_page_featured_image := process_featured_image_path(page_data["featured_image"], page_data["source_file"], settings)
		page_featured_image_url := resolve_media_url(processed_page_featured_image, route_prefix(page_data["route"]))

		page_inner := apply_template(selected_page_template, {
			"title": page_data["title"],
			"featured_image_html": featured_image_html_tag(page_featured_image_url, page_data["title"]),
			"categories_html": taxonomy_terms_html(page_data["categories"]),
			"tags_html": taxonomy_terms_html(page_data["tags"]),
			"taxonomies_html": page_data["taxonomies_html"],
			"body": markdown_to_html(page_data["body"])
		})
		page_navigation := build_navigation(pages_data, custom_collections, page_data["route"], settings["blog_slug"])
		page_html := render_layout(
			layout_template,
			settings,
			page_data["route"],
			page_data["title"],
			page_data["description"],
			page_navigation,
			page_inner,
			{
				"seo_title": page_data["seo_title"],
				"seo_description": page_data["seo_description"],
				"seo_keywords": page_data["keywords"],
				"lang": page_data["lang"],
				"canonical": page_data["canonical"],
				"featured_image": processed_page_featured_image,
				"author": page_data["author"]
			}
		)
		write_route_page(output_dir, page_data["route"], page_html)
		write_route_alias(output_dir, page_data["route"], make_aliases)
		if want_sitemap {
			page_lastmod := parse_post_date(page_data["date"])
			append_file(sitemap_tmp, sitemap_url_entry(site_url, page_data["route"], page_lastmod["iso"], blog_prefix))
		}
		built_pages = push(built_pages, page_data)
	}

	# Posts accumulate as tab-delimited record lines streamed to a temp file
	# (O(1) appends); the index is materialized once via read+split and ordered
	# once via the native sort().
	post_count := 0
	newest_date_sort := 0
	newest_rfc822 := ""
	post_file_idx := 0
	loop {
		if post_file_idx >= len(post_files) || !do_posts {
			break
		}

		current_post_index := post_file_idx
		post_file := post_files[post_file_idx]
		post_file_idx := post_file_idx + 1
		# Shard filter: in "full" mode shards==1 so every post is rendered here;
		# in "posts" mode each worker renders only its stripe of the posts.
		post_stripe := current_post_index % shards
		if post_stripe != shard {
			continue
		}
		parsed := parse_frontmatter(read_file(post_file))
		meta := parsed["meta"]
		if !settings["drafts"] && parse_bool_value(meta["draft"], false) {
			continue
		}

		base_name := replace(basename(post_file), ".md", "")
		slug := clean_slug(base_name)
		override_slug := custom_slug_override(meta)
		if len(override_slug) > 0 {
			slug := override_slug
		}

		title := trim(to_string(meta["title"]))
		if len(title) == 0 {
			title := base_name
		}

		author_name := resolve_lookup(meta["author"], authors_lookup, "Unknown Author")
		categories := meta_terms(meta, "categories", categories_lookup)
		tags := meta_terms(meta, "tags", tags_lookup)
		color_terms := meta_terms(meta, "color", color_lookup)
		post_custom_taxonomies_html := custom_taxonomies_html(meta, "posts", taxonomy_lookups, reserved_taxonomy_slots, has_custom_tax_lookups)

		description := trim(to_string(meta["description"]))
		if len(description) == 0 {
			description := settings["site_tagline"]
		}
		keywords := trim(to_string(meta["keywords"]))
		seo_title := trim(to_string(meta["seo_title"]))
		seo_description := trim(to_string(meta["seo_description"]))
		if len(seo_description) == 0 {
			seo_description = description
		}
		lang := trim(to_string(meta["lang"]))
		if len(lang) == 0 {
			lang = "en"
		}
		canonical := trim(to_string(meta["canonical"]))
		featured_image := trim(to_string(meta["featured_image"]))
		featured_image = process_featured_image_path(featured_image, post_file, settings)

		excerpt := trim(to_string(meta["excerpt"]))
		if len(excerpt) == 0 {
			excerpt := excerpt_from_markdown(parsed["body"])
		} else {
			excerpt := trim(regex_replace(regex_replace(markdown_to_html(excerpt), "<[^>]+>", " "), "\\s+", " "))
		}

		post_date_raw := trim(to_string(meta["date"]))
		post_date := parse_post_date(post_date_raw)
		post_date_display := post_date_raw
		if post_date["valid"] {
			post_date_display = post_date["display"]
		}

		category_text := ""
		if len(categories) > 0 {
			category_text := categories[0]
		}

		route := ""
		if len(settings["blog_slug"]) > 0 && !settings["posts_at_root"] {
			route := settings["blog_slug"] + "/" + slug + "/"
		} else {
			route := slug + "/"
		}

		selected_post_template := post_template
		custom_template_name := trim(to_string(meta["template"]))
		if len(custom_template_name) > 0 {
			custom_post_template := path_join(templates_dir, "post-" + custom_template_name + ".html")
			if path_exists(custom_post_template) {
				selected_post_template := read_file(custom_post_template)
			}
		}
		post_featured_image_url := resolve_media_url(featured_image, route_prefix(route))

		post_inner := apply_template(selected_post_template, {
			"title": title,
			"author": author_name,
			"date": post_date_display,
			"category": category_text,
			"categories": join(categories, ", "),
			"categories_html": taxonomy_terms_html(categories),
			"tags": join(tags, ", "),
			"tags_html": taxonomy_terms_html(tags),
			"colors_html": taxonomy_terms_html(color_terms),
			"taxonomies_html": post_custom_taxonomies_html,
			"featured_image_html": featured_image_html_tag(post_featured_image_url, title),
			"body": markdown_to_html(parsed["body"])
		})

		post_navigation := build_navigation(pages_data, custom_collections, route, settings["blog_slug"])
		post_html := render_layout(
			layout_template,
			settings,
			route,
			title,
			description,
			post_navigation,
			post_inner,
			{
				"seo_title": seo_title,
				"seo_description": seo_description,
				"seo_keywords": keywords,
				"lang": lang,
				"canonical": canonical,
				"featured_image": featured_image,
				"author": author_name,
				"og_type": "article",
				"published_iso": post_date["iso"]
			}
		)
		write_route_page(output_dir, route, post_html)
		write_route_alias(output_dir, route, make_aliases)

		if want_sitemap {
			append_file(sitemap_tmp, sitemap_url_entry(site_url, route, post_date["iso"], blog_prefix))
		}

		if post_date["sort_key"] > newest_date_sort {
			newest_date_sort = post_date["sort_key"]
			newest_rfc822 = post_date["rfc822"]
		}

		order_val := parse_int_value(meta["order"], 1000)
		post_sort_key := post_sort_prefix(settings["sort_by"], post_date["sort_key"], title, author_name, order_val)
		post_record := post_sort_key + "\t" + route + "\t" + title + "\t" + excerpt + "\t" + featured_image + "\t" + join(tags, ",") + "\t" + post_date["rfc822"] + "\t" + post_date["iso"]
		append_file(records_tmp, post_record + "\n")
		post_count := post_count + 1
	}

	# Posts phase: this worker rendered its stripe of posts and wrote its shard
	# record/sitemap temp files. The finalize phase assembles everything else.
	if phase == "posts" {
		print_lines([
			"Posts phase complete (shard " + to_string(shard) + " of " + to_string(shards) + ")",
			"  Posts rendered: " + to_string(post_count)
		])
		return null
	}

	# Materialize and order the post index in a few native, near-linear calls.
	# In finalize, merge every shard's record file first.
	posts_sorted := []
	combined_records := ""
	if phase == "finalize" {
		merge_shard_idx := 0
		loop {
			if merge_shard_idx >= shards {
				break
			}
			shard_records := path_join(output_dir, ".kujo-records-" + to_string(merge_shard_idx) + ".tmp")
			merge_shard_idx := merge_shard_idx + 1
			if path_exists(shard_records) {
				shard_chunk := trim(read_file(shard_records))
				if len(shard_chunk) > 0 {
					if len(combined_records) > 0 {
						combined_records = combined_records + "\n"
					}
					combined_records = combined_records + shard_chunk
				}
			}
		}
	} else if post_count > 0 && path_exists(records_tmp) {
		combined_records = trim(read_file(records_tmp))
		delete_file(records_tmp)
	}
	if len(combined_records) > 0 {
		posts_sorted = sort(split(combined_records, "\n"))
	}

	# In finalize, posts weren't re-rendered here, so derive the newest post date
	# (for RSS lastBuildDate) from the merged records.
	if phase == "finalize" {
		newest_iso := ""
		newest_scan_idx := 0
		loop {
			if newest_scan_idx >= len(posts_sorted) {
				break
			}
			scan_record := parse_post_record(posts_sorted[newest_scan_idx])
			newest_scan_idx := newest_scan_idx + 1
			scan_iso := trim(to_string(scan_record["date_iso"]))
			if len(scan_iso) == 10 && scan_iso > newest_iso {
				newest_iso = scan_iso
				newest_rfc822 = trim(to_string(scan_record["date_rfc822"]))
			}
		}
	}

	llms_collections_tmp := path_join(output_dir, ".kujo-llms-collections.tmp")
	if path_exists(llms_collections_tmp) {
		delete_file(llms_collections_tmp)
	}
	collection_idx := 0
	loop {
		if collection_idx >= len(custom_collections) {
			break
		}

		collection := custom_collections[collection_idx]
		collection_idx := collection_idx + 1
		collection_slug := collection["slug"]
		collection_title := collection["title"]
		collection_files := collection["files"]
		collection_items := []

		default_collection_item_template := post_template
		collection_item_template_path := path_join(templates_dir, collection_slug + ".html")
		if path_exists(collection_item_template_path) {
			default_collection_item_template := read_file(collection_item_template_path)
		}

		collection_file_idx := 0
		loop {
			if collection_file_idx >= len(collection_files) {
				break
			}

			item_file := collection_files[collection_file_idx]
			collection_file_idx := collection_file_idx + 1
			parsed := parse_frontmatter(read_file(item_file))
			meta := parsed["meta"]
			if !settings["drafts"] && parse_bool_value(meta["draft"], false) {
				continue
			}

			base_name := replace(basename(item_file), ".md", "")
			slug := clean_slug(base_name)
			override_slug := custom_slug_override(meta)
			if len(override_slug) > 0 {
				slug := override_slug
			}

			title := trim(to_string(meta["title"]))
			if len(title) == 0 {
				title := base_name
			}

			description := trim(to_string(meta["description"]))
			if len(description) == 0 {
				description := settings["site_tagline"]
			}
			keywords := trim(to_string(meta["keywords"]))
			seo_title := trim(to_string(meta["seo_title"]))
			seo_description := trim(to_string(meta["seo_description"]))
			if len(seo_description) == 0 {
				seo_description = description
			}
			lang := trim(to_string(meta["lang"]))
			if len(lang) == 0 {
				lang = "en"
			}
			canonical := trim(to_string(meta["canonical"]))
			featured_image := trim(to_string(meta["featured_image"]))
			featured_image = process_featured_image_path(featured_image, item_file, settings)

			excerpt := trim(to_string(meta["excerpt"]))
			if len(excerpt) == 0 {
				excerpt := excerpt_from_markdown(parsed["body"])
			} else {
				excerpt := trim(regex_replace(regex_replace(markdown_to_html(excerpt), "<[^>]+>", " "), "\\s+", " "))
			}

			item_date_raw := trim(to_string(meta["date"]))
			item_date := parse_post_date(item_date_raw)
			item_date_display := item_date_raw
			if item_date["valid"] {
				item_date_display = item_date["display"]
			}

			item_categories := meta_terms(meta, "categories", categories_lookup)
			tags := meta_terms(meta, "tags", tags_lookup)
			color_terms := meta_terms(meta, "color", color_lookup)
			location_terms := meta_terms(meta, "location", locations_lookup)
			item_custom_taxonomies_html := custom_taxonomies_html(meta, collection_slug, taxonomy_lookups, reserved_taxonomy_slots, has_custom_tax_lookups)

			item_category_text := collection_title
			if len(item_categories) > 0 {
				item_category_text = item_categories[0]
			}

			route := collection_slug + "/" + slug + "/"

			selected_collection_template := default_collection_item_template
			custom_template_name := trim(to_string(meta["template"]))
			if len(custom_template_name) > 0 {
				custom_collection_template := path_join(templates_dir, "post-" + custom_template_name + ".html")
				if path_exists(custom_collection_template) {
					selected_collection_template := read_file(custom_collection_template)
				}
			}
			item_featured_image_url := resolve_media_url(featured_image, route_prefix(route))

			item_inner := apply_template(selected_collection_template, {
				"title": title,
				"author": resolve_lookup(meta["author"], authors_lookup, "Unknown Author"),
				"date": item_date_display,
				"category": item_category_text,
				"categories": join(item_categories, ", "),
				"categories_html": taxonomy_terms_html(item_categories),
				"tags": join(tags, ", "),
				"tags_html": taxonomy_terms_html(tags),
				"colors_html": taxonomy_terms_html(color_terms),
				"locations_html": taxonomy_terms_html(location_terms),
				"taxonomies_html": item_custom_taxonomies_html,
				"featured_image_html": featured_image_html_tag(item_featured_image_url, title),
				"body": markdown_to_html(parsed["body"])
			})
			item_author_name := resolve_lookup(meta["author"], authors_lookup, "Unknown Author")

			item_navigation := build_navigation(pages_data, custom_collections, route, settings["blog_slug"])
			item_html := render_layout(
				layout_template,
				settings,
				route,
				title,
				description,
				item_navigation,
				item_inner,
				{
					"seo_title": seo_title,
					"seo_description": seo_description,
					"seo_keywords": keywords,
					"lang": lang,
					"canonical": canonical,
					"featured_image": featured_image,
					"author": item_author_name,
					"og_type": "article",
					"published_iso": item_date["iso"]
				}
			)
			write_route_page(output_dir, route, item_html)
			write_route_alias(output_dir, route, make_aliases)

			if want_sitemap {
				append_file(sitemap_tmp, sitemap_url_entry(site_url, route, item_date["iso"], blog_prefix))
			}
			collection_items = push(collection_items, {
				"title": title,
				"author": item_author_name,
				"date": item_date_raw,
				"date_display": item_date_display,
				"date_sort_key": item_date["sort_key"],
				"date_rfc822": item_date["rfc822"],
				"date_iso": item_date["iso"],
				"description": description,
				"excerpt": excerpt,
				"featured_image": featured_image,
				"tags": tags,
				"location_terms": location_terms,
				"route": route,
				"order": parse_int_value(meta["order"], 1000)
			})
		}

		if len(collection_items) == 0 {
			continue
		}

		sorted_collection_items := sort_posts(collection_items, settings["sort_by"])
		collection_cards := ""
		preview_cards := ""
		location_cards := ""
		preview_count := 0
		sorted_item_idx := 0
		loop {
			if sorted_item_idx >= len(sorted_collection_items) {
				break
			}

			item := sorted_collection_items[sorted_item_idx]
			sorted_item_idx := sorted_item_idx + 1
			item_action_label := "View Product"
			if collection_slug == "storefronts" {
				item_action_label = "View Storefront"
			}
			collection_cards := collection_cards + listing_card_html(item["route"], item["title"], item["excerpt"], item["featured_image"], item["tags"], item_action_label)
			if preview_count < 6 {
				preview_cards = preview_cards + listing_card_html(item["route"], item["title"], item["excerpt"], item["featured_image"], item["tags"], item_action_label)
				if collection_slug == "storefronts" {
					location_cards = location_cards + listing_card_html(item["route"], item["title"], item["excerpt"], item["featured_image"], item["location_terms"], "View Location")
				}
				preview_count := preview_count + 1
			}
		}
		if collection_slug == "storefronts" {
			storefront_preview_cards = preview_cards
			location_preview_cards = location_cards
		}

		listing_route := collection_slug + "/"
		listing_content := "<main class=\"container max-w-2xl m-auto py-10 px-4\" id=\"main-content\"><h1 class=\"text-6xl font-bold mb-8 pb-8 text-links font-heading-bold border-b border-primary page-title\">" + collection_title + "</h1><ul class=\"card-grid\">" + collection_cards + "</ul></main>"
		listing_template_path := path_join(templates_dir, "page-" + collection_slug + ".html")
		if path_exists(listing_template_path) {
			listing_template := read_file(listing_template_path)
			listing_content = apply_template(listing_template, {
				"title": collection_title,
				"content_type": collection_slug,
				"cards": collection_cards,
				"items": collection_cards,
				"posts": collection_cards,
				"pagination": "",
				"description": settings["site_tagline"]
			})
		}

		listing_navigation := build_navigation(pages_data, custom_collections, listing_route, settings["blog_slug"])
		listing_html := render_layout(
			layout_template,
			settings,
			listing_route,
			collection_title + " - " + settings["site_title"],
			settings["site_tagline"],
			listing_navigation,
			listing_content,
			{
				"seo_title": collection_title,
				"seo_description": settings["site_tagline"],
				"lang": "en"
			}
		)
		write_route_page(output_dir, listing_route, listing_html)
		write_route_alias(output_dir, listing_route, make_aliases)
		if want_sitemap {
			append_file(sitemap_tmp, sitemap_url_entry(site_url, listing_route, "", blog_prefix))
		}
		if settings["llms"] == "public" && len(site_url) > 0 && !settings["no_aux"] {
			append_file(llms_collections_tmp, "\n## " + collection_title + "\n")
			append_file(llms_collections_tmp, "- [" + collection_title + " index](" + site_url + "/" + listing_route + ")\n")
			llms_item_idx := 0
			loop {
				if llms_item_idx >= len(sorted_collection_items) {
					break
				}

				item := sorted_collection_items[llms_item_idx]
				llms_item_idx := llms_item_idx + 1
				append_file(llms_collections_tmp, "- [" + item["title"] + "](" + site_url + "/" + item["route"] + ")\n")
			}
		}
	}

	total_posts := len(posts_sorted)
	total_pages := 1
	if total_posts > 0 {
		total_pages := total_posts / settings["posts_per_page"]
		if total_posts % settings["posts_per_page"] != 0 {
			total_pages := total_pages + 1
		}
	}

	if !settings["no_index"] {
		featured_posts_cards := ""
		featured_posts_limit := 4
		featured_idx := 0
		loop {
			if featured_idx >= total_posts || featured_idx >= featured_posts_limit {
				break
			}
			featured_post := parse_post_record(posts_sorted[featured_idx])
			featured_posts_cards = featured_posts_cards + listing_card_html(featured_post["route"], featured_post["title"], featured_post["excerpt"], featured_post["featured_image"], featured_post["tags"], "Read Article")
			featured_idx := featured_idx + 1
		}

		page_num := 1
		loop {
			if page_num > total_pages {
				break
			}

			start_idx := (page_num - 1) * settings["posts_per_page"]
			end_idx := start_idx + settings["posts_per_page"]
			if end_idx > total_posts {
				end_idx := total_posts
			}

			cards := ""
			i := start_idx
			loop {
				if i >= end_idx {
					break
				}
				post := parse_post_record(posts_sorted[i])
				cards := cards + listing_card_html(post["route"], post["title"], post["excerpt"], post["featured_image"], post["tags"], "Read Article")
				i := i + 1
			}

			index_posts_html := "<ul class=\"card-grid\">" + cards + "</ul>"
			index_pagination := build_pagination_links(page_num, total_pages, "")
			index_content := "<main class=\"container max-w-2xl m-auto py-10 px-4\" id=\"main-content\"><h1 class=\"text-6xl font-bold mb-8 pb-8 text-links font-heading-bold border-b border-primary page-title\">" + html_escape(settings["site_title"]) + "</h1>" + index_posts_html + index_pagination + "</main>"
			if len(home_listing_template) > 0 {
				storefront_preview := storefront_preview_cards
				location_preview := location_preview_cards
				if len(location_preview) == 0 {
					location_preview = storefront_preview
				}
				index_content = apply_template(home_listing_template, {
					"title": settings["site_title"],
					"description": settings["site_tagline"],
					"cards": cards,
					"items": cards,
					"posts": cards,
					"featured_posts_html": featured_posts_cards,
					"featured_storefronts_html": storefront_preview,
					"featured_locations_html": location_preview,
					"posts_html": index_posts_html,
					"pagination": index_pagination,
					"page_number": page_num,
					"total_pages": total_pages,
					"blog_slug": settings["blog_slug"]
				})
			}

			index_route := ""
			if page_num > 1 {
				index_route := "page/" + to_string(page_num) + "/"
			}

			index_navigation := build_navigation(pages_data, custom_collections, index_route, settings["blog_slug"])
			index_html := render_layout(
				layout_template,
				settings,
				index_route,
				settings["site_title"],
				settings["site_tagline"],
				index_navigation,
				index_content,
				{
					"seo_title": settings["site_title"],
					"seo_description": settings["site_tagline"],
					"lang": "en"
				}
			)
			write_route_page(output_dir, index_route, index_html)
			write_route_alias(output_dir, index_route, make_aliases)
			if want_sitemap {
				append_file(sitemap_tmp, sitemap_url_entry(site_url, index_route, "", blog_prefix))
			}

			if len(settings["blog_slug"]) > 0 {
				blog_route := settings["blog_slug"] + "/"
				if page_num > 1 {
					blog_route := settings["blog_slug"] + "/page/" + to_string(page_num) + "/"
				}

				blog_posts_html := "<ul class=\"card-grid\">" + cards + "</ul>"
				blog_pagination := build_pagination_links(page_num, total_pages, settings["blog_slug"] + "/")
				blog_content := "<main class=\"container max-w-2xl m-auto py-10 px-4\" id=\"main-content\"><h1 class=\"text-6xl font-bold mb-8 pb-8 text-links font-heading-bold border-b border-primary page-title\">Blog</h1>" + blog_posts_html + blog_pagination + "</main>"
				if len(blog_listing_template) > 0 {
					blog_content = apply_template(blog_listing_template, {
						"title": "Blog",
						"description": settings["site_tagline"],
						"cards": cards,
						"items": cards,
						"posts": cards,
						"posts_html": blog_posts_html,
						"pagination": blog_pagination,
						"page_number": page_num,
						"total_pages": total_pages,
						"blog_slug": settings["blog_slug"]
					})
				}

				blog_navigation := build_navigation(pages_data, custom_collections, blog_route, settings["blog_slug"])
				blog_html := render_layout(
					layout_template,
					settings,
					blog_route,
					"Blog - " + settings["site_title"],
					settings["site_tagline"],
					blog_navigation,
					blog_content,
					{
						"seo_title": "Blog",
						"seo_description": settings["site_tagline"],
						"lang": "en"
					}
				)
				write_route_page(output_dir, blog_route, blog_html)
				write_route_alias(output_dir, blog_route, make_aliases)
				if want_sitemap {
					append_file(sitemap_tmp, sitemap_url_entry(site_url, blog_route, "", blog_prefix))
				}
			}

			page_num := page_num + 1
		}
	}

	if !settings["no_aux"] {
		if len(site_url) > 0 {
			rss_items := ""
			rss_limit := 20
			rss_count := 0
			rss_post_idx := 0
			loop {
				if rss_post_idx >= len(posts_sorted) || rss_count >= rss_limit {
					break
				}

				post := parse_post_record(posts_sorted[rss_post_idx])
				rss_post_idx := rss_post_idx + 1
				post_url := site_url + "/" + post["route"]
				rss_description := trim(regex_replace(regex_replace(to_string(post["excerpt"]), "<[^>]+>", " "), "\\s+", " "))
				pub_date_tag := ""
				post_rfc822 := trim(to_string(post["date_rfc822"]))
				if len(post_rfc822) > 0 {
					pub_date_tag = "<pubDate>" + post_rfc822 + "</pubDate>"
				}
				rss_items := rss_items + "<item><title>" + xml_escape(post["title"]) + "</title><link>" + xml_escape(post_url) + "</link><guid isPermaLink=\"true\">" + xml_escape(post_url) + "</guid>" + pub_date_tag + "<description>" + xml_escape(rss_description) + "</description></item>"
				rss_count := rss_count + 1
			}
			last_build_tag := ""
			if len(newest_rfc822) > 0 {
				last_build_tag = "<lastBuildDate>" + newest_rfc822 + "</lastBuildDate>"
			}
			rss_xml := "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\"><channel><title>" + xml_escape(settings["site_title"]) + "</title><link>" + xml_escape(site_url) + "</link><description>Latest posts from " + xml_escape(settings["site_title"]) + "</description>" + last_build_tag + rss_items + "</channel></rss>\n"
			ensure_dir(path_join(output_dir, "feed"))
			write_file(path_join(output_dir, "feed/index.xml"), rss_xml)

			# Sitemap entries were streamed to a temp file during rendering. In
			# finalize mode, also merge each posts shard's sitemap temp file.
			sitemap_inner := ""
			if path_exists(sitemap_tmp) {
				sitemap_inner = read_file(sitemap_tmp)
			}
			if phase == "finalize" {
				sm_shard_idx := 0
				loop {
					if sm_shard_idx >= shards {
						break
					}
					shard_sitemap := path_join(output_dir, ".kujo-sitemap-posts-" + to_string(sm_shard_idx) + ".tmp")
					sm_shard_idx := sm_shard_idx + 1
					if path_exists(shard_sitemap) {
						sitemap_inner = sitemap_inner + read_file(shard_sitemap)
						delete_file(shard_sitemap)
					}
				}
			}
			sitemap_xml := "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd\">\n" + sitemap_inner + "</urlset>\n"
			write_file(path_join(output_dir, "sitemap.xml"), sitemap_xml)
		} else {
			print("Skipping RSS and sitemap (no --site-url configured)")
		}

		robots := "User-agent: *\nAllow: /\n"
		if settings["robots"] == "private" {
			robots := "User-agent: *\nDisallow: /\n"
		} else if len(site_url) > 0 {
			robots := robots + "\nSitemap: " + site_url + "/sitemap.xml\n"
		}
		write_file(path_join(output_dir, "robots.txt"), robots)

		if settings["llms"] == "public" && len(site_url) > 0 {
			# Streamed to the output file directly (O(1) appends) since string
			# concatenation of a large body is O(n^2) in Kujo.
			llms_path := path_join(output_dir, "llms.txt")
			write_file(llms_path, "# " + settings["site_title"] + "\n\nThis site contains structured content formatted for LLM-friendly consumption.\n\n## Posts\n")
			llms_post_idx := 0
			loop {
				if llms_post_idx >= len(posts_sorted) {
					break
				}

				post := parse_post_record(posts_sorted[llms_post_idx])
				llms_post_idx := llms_post_idx + 1
				append_file(llms_path, "- [" + post["title"] + "](" + site_url + "/" + post["route"] + ")\n")
			}
			append_file(llms_path, "\n## Pages\n")
			built_page_idx := 0
			loop {
				if built_page_idx >= len(built_pages) {
					break
				}

				page_data := built_pages[built_page_idx]
				built_page_idx := built_page_idx + 1
				append_file(llms_path, "- [" + page_data["title"] + "](" + site_url + "/" + page_data["route"] + ")\n")
			}
			if path_exists(llms_collections_tmp) {
				append_file(llms_path, read_file(llms_collections_tmp))
				delete_file(llms_collections_tmp)
			}
			append_file(llms_path, "\n## Sitemap\n" + site_url + "/sitemap.xml\n")
		}
	}

	not_found_navigation := build_navigation(pages_data, custom_collections, "", settings["blog_slug"])
	not_found_html := render_layout(
		layout_template,
		settings,
		"",
		"Page Not Found - " + settings["site_title"],
		"Page not found",
		not_found_navigation,
		not_found_template,
		{
			"seo_title": "Page Not Found",
			"seo_description": "Page not found",
			"lang": "en"
		}
	)
	write_file(path_join(output_dir, "404.html"), not_found_html)

	# Remove streaming temp files so they never appear in the published output.
	if path_exists(sitemap_tmp) {
		delete_file(sitemap_tmp)
	}
	if path_exists(records_tmp) {
		delete_file(records_tmp)
	}
	if phase == "finalize" {
		cleanup_shard_idx := 0
		loop {
			if cleanup_shard_idx >= shards {
				break
			}
			leftover_records := path_join(output_dir, ".kujo-records-" + to_string(cleanup_shard_idx) + ".tmp")
			leftover_sitemap := path_join(output_dir, ".kujo-sitemap-posts-" + to_string(cleanup_shard_idx) + ".tmp")
			cleanup_shard_idx := cleanup_shard_idx + 1
			if path_exists(leftover_records) {
				delete_file(leftover_records)
			}
			if path_exists(leftover_sitemap) {
				delete_file(leftover_sitemap)
			}
		}
		post_manifest_cleanup := path_join(output_dir, ".kujo-post-manifest.txt")
		if path_exists(post_manifest_cleanup) {
			delete_file(post_manifest_cleanup)
		}
	}

	if settings["minify"] {
		minify_assets_recursive(path_join(output_dir, "assets"))
	}

	total_time := (performance_now() - build_start) / 1000.0
	print_lines([
		"Build complete",
		"  Posts generated: " + to_string(total_posts),
		"  Pages generated: " + to_string(len(built_pages)),
		"  Output directory: " + output_dir,
		"  Build time: " + to_string(total_time) + "s"
	])
}

cli_args := args()
settings := default_settings()
config_result := load_config(settings)
settings := config_result["settings"]

if len(config_result["errors"]) > 0 {
	print_errors(config_result["errors"])
	exit(1)
}

cli_result := apply_cli_overrides(settings, cli_args)
settings := cli_result["settings"]

if len(cli_result["errors"]) > 0 {
	print_errors(cli_result["errors"])
	if cli_result["show_help"] {
		print("")
		print_help()
	}
	exit(1)
}

if cli_result["show_help"] {
	print_help()
	exit(0)
}

if cli_result["show_version"] {
	print("build.kujo " + VERSION)
	exit(0)
}

init_format := trim(to_string(cli_result["init_format"]))
if len(init_format) > 0 {
	init_project(init_format)
	exit(0)
}

normalize_result := normalize_settings(settings)
settings := normalize_result["settings"]

if len(normalize_result["errors"]) > 0 {
	print_errors(normalize_result["errors"])
	exit(1)
}

if settings["watch"] {
	print("Warning: --watch is currently not implemented.")
}

build_site(settings)
