	return {
		"output": "output",
		"content": "content",
		"templates": "templates",
		"assets": "assets",
		"posts_per_page": 5,
		"sort_by": "date",
		"fonts": ["Bree Serif", "Inter"],
		"site_title": "My Static Site",
		"site_tagline": "Built with Kujo SSG",
		"site_url": "",
		"robots": "public",
		"llms": "public",
		"watch": false,
		"minify": false,
		"download_remote_images": false,
		"drafts": false,
		"blog_slug": "blog",
		"posts_at_root": false,
		"no_index": false,
		"no_aux": false,
		"no_aliases": false,
		"phase": "full",
		"shard": 0,
		"shards": 1
	}
}

func parse_bool_value(value, fallback) {
	if value == null {
		return fallback
	}
	if is_bool(value) {
		return value
	}
	if is_int(value) {
		return value != 0
	}
	if is_string(value) {
		lowered := to_lower(trim(value))
		if lowered == "true" || lowered == "1" || lowered == "yes" || lowered == "on" {
			return true
		}
		if lowered == "false" || lowered == "0" || lowered == "no" || lowered == "off" {
			return false
		}
	}
	return fallback
}

func parse_int_value(value, fallback) {
	if value == null {
		return fallback
	}
	if is_int(value) {
		return value
	}
	if is_float(value) {
		return to_int(value)
	}
	if is_string(value) {
		try {
			return to_int(trim(value))
		} except err {
			return fallback
		}
	}
	return fallback
}

func is_integer_text(value) {
	text := trim(to_string(value))
	if len(text) == 0 {
		return false
	}

	start_index := 0
	first_char := substring(text, 0, 1)
	if first_char == "+" || first_char == "-" {
		if len(text) == 1 {
			return false
		}
		start_index := 1
	}

	i := start_index
	loop {
		if i >= len(text) {
			break
		}

		char := substring(text, i, i + 1)
		if index_of("0123456789", char) < 0 {
			return false
		}

		i := i + 1
	}

	return true
}

func trim_quotes(value) {
	clean := trim(value)
	if len(clean) >= 2 {
		if starts_with(clean, "\"") && ends_with(clean, "\"") {
			clean := substring(clean, 1, len(clean) - 1)
		}
		if starts_with(clean, "'") && ends_with(clean, "'") {
			clean := substring(clean, 1, len(clean) - 1)
		}
	}
	return trim(clean)
}

func option_inline_value(token, flag) {
	prefix := flag + "="
	if starts_with(token, prefix) {
		return substring(token, len(prefix), len(token))
	}
	return null
}

func string_in_list(value, allowed_values) {
	i := 0
	loop {
		if i >= len(allowed_values) {
			break
		}

		if value == allowed_values[i] {
			return true
		}

		i := i + 1
	}

	return false
}

func is_valid_bool_input(value) {
	if value == null {
		return true
	}
	if is_bool(value) || is_int(value) {
		return true
	}
	if is_string(value) {
		lowered := to_lower(trim(value))
		return lowered == "true" || lowered == "1" || lowered == "yes" || lowered == "on" || lowered == "false" || lowered == "0" || lowered == "no" || lowered == "off"
	}
	return false
}

func print_errors(errors) {
	i := 0
	loop {
		if i >= len(errors) {
			break
		}

		print("Error: " + to_string(errors[i]))
		i := i + 1
	}
}

func safe_error_text(err) {
	try {
		return to_string(err)
	} except nested_err {
		return "unknown error"
	}
}

func ensure_dir(path) {
	clean_path := trim(path)
	if len(clean_path) == 0 || clean_path == "." {
		return null
	}

	parts := split(clean_path, "/")
	# Preserve a leading "/" so absolute paths (e.g. an absolute --output) are
	# built from the filesystem root instead of being silently rewritten relative
	# to the current working directory.
	current := ""
	if starts_with(clean_path, "/") {
		current := "/"
	}
	part_idx := 0
	loop {
		if part_idx >= len(parts) {
			break
		}

		part := parts[part_idx]
		part_idx := part_idx + 1
		segment := trim(part)
		if len(segment) == 0 {
			continue
		}
		if len(current) == 0 {
			current := segment
		} else if current == "/" {
			current := "/" + segment
		} else {
			current := path_join(current, segment)
		}
		if !path_exists(current) {
			create_dir(current)
		}
	}
}

func ensure_dirs(paths) {
	i := 0
	loop {
		if i >= len(paths) {
			break
		}

		ensure_dir(paths[i])
		i := i + 1
	}
}

func write_if_missing(path, content) {
	if path_exists(path) {
		return null
	}
	parent := dirname(path)
	if len(parent) > 0 {
		ensure_dir(parent)
	}
	write_file(path, content)
}

func write_seed_files(files) {
	i := 0
	loop {
		if i >= len(files) {
			break
		}

		file := files[i]
		write_if_missing(file["path"], file["content"])
		i := i + 1
	}
}

func normalize_route(route) {
	clean := trim(route)
	if len(clean) == 0 {
		return ""
	}
	if starts_with(clean, "/") {
		clean := substring(clean, 1, len(clean))
	}
	if !ends_with(clean, "/") {
		clean := clean + "/"
	}
	return clean
}

func route_depth(route) {
	clean := normalize_route(route)
	if len(clean) == 0 {
		return 0
	}
	parts := split(clean, "/")
	count := 0
	part_idx := 0
	loop {
		if part_idx >= len(parts) {
			break
		}

		part := parts[part_idx]
		part_idx := part_idx + 1
		if len(trim(part)) > 0 {
			count := count + 1
		}
	}
	return count
}

func route_prefix(route) {
	depth := route_depth(route)
	prefix := ""
	i := 0
	loop {
		if i >= depth {
			break
		}
		prefix := prefix + "../"
		i := i + 1
	}
	return prefix
}

func clean_slug(text) {
	slug := to_lower(trim(text))
	slug := regex_replace(slug, "[^a-z0-9]+", "-")
	slug := regex_replace(slug, "^-+|-+$", "")
	if len(slug) == 0 {
		return "untitled"
	}
	return slug
}

func custom_slug_override(meta) {
	candidate := trim(to_string(meta["custom_url"]))
	if len(candidate) == 0 {
		return ""
	}
	if contains(candidate, "/") {
		return ""
	}
	lowered := to_lower(candidate)
	if ends_with(lowered, ".jpg") || ends_with(lowered, ".jpeg") || ends_with(lowered, ".png") || ends_with(lowered, ".gif") || ends_with(lowered, ".webp") {
		return ""
	}
	return clean_slug(candidate)
}

func markdown_files(directory) {
	files := []
	if !path_exists(directory) || !path_is_dir(directory) {
		return files
	}
	entries := sort(list_dir(directory))
	entry_idx := 0
	loop {
		if entry_idx >= len(entries) {
			break
		}

		entry := entries[entry_idx]
		entry_idx := entry_idx + 1
		full_path := path_join(directory, entry)
		if path_is_file(full_path) && ends_with(entry, ".md") {
			files = push(files, full_path)
		}
	}
	return files
}

func to_string_array(value) {
	out := []
	if value == null {
		return out
	}
	if is_array(value) {
		item_idx := 0
		loop {
			if item_idx >= len(value) {
				break
			}

			item := value[item_idx]
			item_idx := item_idx + 1
			clean := trim_quotes(to_string(item))
			if len(clean) > 0 {
				out = push(out, clean)
			}
		}
		return out
	}

	text := trim(to_string(value))
	if len(text) == 0 {
		return out
	}
	if starts_with(text, "[") && ends_with(text, "]") && len(text) >= 2 {
		text := substring(text, 1, len(text) - 1)
	}
	parts := split(text, ",")
	part_idx := 0
	loop {
		if part_idx >= len(parts) {
			break
		}

		part := parts[part_idx]
		part_idx := part_idx + 1
		clean := trim_quotes(part)
		if len(clean) > 0 {
			out = push(out, clean)
		}
	}
	return out
}

func push_unique_string(values, value) {
	needle := trim(to_string(value))
	if len(needle) == 0 {
		return values
	}
	needle_key := to_lower(needle)
	i := 0
	loop {
		if i >= len(values) {
			break
		}
		if to_lower(trim(to_string(values[i]))) == needle_key {
			return values
		}
		i := i + 1
	}
	return push(values, needle)
}

func merge_unique_strings(left, right) {
	out := left
	i := 0
	loop {
		if i >= len(right) {
			break
		}
		out = push_unique_string(out, right[i])
		i := i + 1
	}
	return out
}

func normalize_taxonomies_map(value) {
	out := {}
	if !is_dict(value) {
		return out
	}

	taxonomy_keys := keys(value)
	i := 0
	loop {
		if i >= len(taxonomy_keys) {
			break
		}
		raw_key := taxonomy_keys[i]
		i := i + 1

		taxonomy_name := clean_slug(raw_key)
		if taxonomy_name == "untitled" {
			continue
		}
		terms := to_string_array(value[raw_key])
		if len(terms) > 0 {
			out[taxonomy_name] = terms
		}
	}

	return out
}

func inline_markdown(text) {
	out := text
	# Cheap substring guards avoid recompiling/running the inline regexes on the
	# overwhelmingly common case of plain prose lines (large-site hot path).
	if index_of(out, "![") >= 0 {
		out := regex_replace(out, "!\\[([^\\]]*)\\]\\(([^\\)]+)\\)", "<img src=\"$2\" alt=\"$1\">")
	}
	if index_of(out, "[") >= 0 {
		out := regex_replace(out, "\\[([^\\]]+)\\]\\(([^\\)]+)\\)", "<a href=\"$2\">$1</a>")
	}
	if index_of(out, "**") >= 0 {
		out := regex_replace(out, "\\*\\*([^\\*]+)\\*\\*", "<strong>$1</strong>")
	}
	if index_of(out, "*") >= 0 {
		out := regex_replace(out, "\\*([^\\*]+)\\*", "<em>$1</em>")
	}
	if index_of(out, "`") >= 0 {
		out := regex_replace(out, "`([^`]+)`", "<code>$1</code>")
	}
	return out
}

# Delegates to the native markdown renderer (compiled once, byte-identical to
# the previous interpreted implementation). The Kujo block/inline logic is
# preserved in render_markdown_native in the runtime.
func markdown_to_html(markdown) {
	return render_markdown(markdown)
}

func excerpt_from_markdown(markdown) {
	html := markdown_to_html(markdown)
	plain := regex_replace(html, "<[^>]+>", " ")
	plain := regex_replace(plain, "\\s+", " ")
	plain := trim(plain)
	if len(plain) == 0 {
		return ""
	}

	words := split(plain, " ")
	if len(words) <= 30 {
		return plain
	}
	out := []
	i := 0
	loop {
		if i >= len(words) || i >= 30 {
			break
		}
		out = push(out, words[i])
		i := i + 1
	}
	return join(out, " ") + "..."
}

func parse_frontmatter(content) {
	meta := {
		"title": "",
		"author": "",
		"date": "",
		"category": "",
		"description": "",
		"keywords": "",
		"seo_title": "",
		"seo_description": "",
		"lang": "en",
		"canonical": "",
		"featured_image": "",
		"custom_url": "",
		"template": "",
		"draft": false,
		"order": 1000,
		"excerpt": "",
		"nav_hide": false,
		"tags": [],
		"categories": [],
		"taxonomies": {}
	}
	body := trim(content)

	trimmed := trim(content)
	if starts_with(trimmed, "---") {
		parts := split(content, "---")
		if len(parts) >= 3 {
			frontmatter_text := trim(parts[1])
			body_parts := []
			idx := 2
			loop {
				if idx >= len(parts) {
					break
				}
				body_parts = push(body_parts, parts[idx])
				idx := idx + 1
			}
			body := trim(join(body_parts, "---"))

			if len(frontmatter_text) > 0 {
				try {
					parsed := parse_yaml(frontmatter_text)
					if is_dict(parsed) {
						parsed_keys := keys(parsed)
						parsed_key_idx := 0
						loop {
							if parsed_key_idx >= len(parsed_keys) {
								break
							}

							key := parsed_keys[parsed_key_idx]
							parsed_key_idx := parsed_key_idx + 1
							meta[key] = parsed[key]
						}
					}
				} except err {
					# Ignore frontmatter parse errors and keep defaults.
				}
			}
		}
	}

	meta["draft"] = parse_bool_value(meta["draft"], false)
	meta["nav_hide"] = parse_bool_value(meta["nav_hide"], false)
	meta["order"] = parse_int_value(meta["order"], 1000)
	meta["tags"] = to_string_array(meta["tags"])
	meta["categories"] = to_string_array(meta["categories"])
	meta["taxonomies"] = normalize_taxonomies_map(meta["taxonomies"])

	return {
		"meta": meta,
		"body": body
	}
}

func apply_template(template, data) {
	out := template
	data_keys := keys(data)
	data_key_idx := 0
	loop {
		if data_key_idx >= len(data_keys) {
			break
		}

		key := data_keys[data_key_idx]
		data_key_idx := data_key_idx + 1
		placeholder := "{{" + key + "}}"
		out := replace(out, placeholder, to_string(data[key]))
	}
	return out
}

# Delegates to the native single-pass escaper (5 interpreted string passes →
# one native pass); output is byte-identical to the previous implementation.
func xml_escape(value) {
	return escape_xml(value)
}

func html_escape(value) {
	return escape_xml(value)
}

func route_to_path(route) {
	clean := normalize_route(route)
	if len(clean) == 0 {
		return "/"
	}
	return "/" + clean
}

func navigation_item(href, label, is_current) {
	safe_href := xml_escape(href)
	safe_label := html_escape(label)
	current_attr := ""
	if is_current {
		current_attr = " aria-current=\"page\""
	}
	return "<li><a href=\"" + safe_href + "\" class=\"text-primary hover:underline\"" + current_attr + ">" + safe_label + "</a></li>"
}

func build_navigation(pages_data, custom_collections, current_route, blog_slug) {
	current_path := route_to_path(current_route)
	html := navigation_item("/", "Home", current_path == "/")
	clean_blog_slug := clean_slug(trim(to_string(blog_slug)))
	if len(clean_blog_slug) > 0 && clean_blog_slug != "untitled" {
		blog_path := "/" + clean_blog_slug + "/"
		html = html + navigation_item(blog_path, "Blog", starts_with(current_path, blog_path))
	}

	page_idx := 0
	loop {
		if page_idx >= len(pages_data) {
			break
		}

		page_data := pages_data[page_idx]
		page_idx := page_idx + 1
		if page_data["nav_hide"] {
			continue
		}
		page_path := route_to_path(page_data["route"])
		html = html + navigation_item(page_path, page_data["title"], page_path == current_path)
	}

	collection_idx := 0
	loop {
		if collection_idx >= len(custom_collections) {
			break
		}

		collection := custom_collections[collection_idx]
		collection_idx := collection_idx + 1
		collection_path := route_to_path(collection["route"])
		collection_label := collection["title"]
		html = html + navigation_item(collection_path, collection_label, collection_path == current_path)
	}

	return html
}

func load_lookup(path) {
	lookup := {}
	if !path_exists(path) {
		return lookup
	}
	try {
		parsed := parse_yaml(read_file(path))
		if is_dict(parsed) {
			parsed_keys := keys(parsed)
			parsed_key_idx := 0
			loop {
				if parsed_key_idx >= len(parsed_keys) {
					break
				}

				key := parsed_keys[parsed_key_idx]
				parsed_key_idx := parsed_key_idx + 1
				entry := parsed[key]
				if is_dict(entry) && has_key(entry, "name") {
					lookup[to_string(key)] = to_string(entry["name"])
				} else {
					lookup[to_string(key)] = to_string(entry)
				}
			}
		}
	} except err {
		# Lookup files are optional.
	}
	return lookup
}

func resolve_lookup(value, lookup, fallback) {
	if value == null {
		return fallback
	}
	key := trim(to_string(value))
	if len(key) == 0 {
		return fallback
	}
	if has_key(lookup, key) {
		return lookup[key]
	}
	number_wrapped := "Number(" + key + ")"
	if has_key(lookup, number_wrapped) {
		return lookup[number_wrapped]
	}
	if starts_with(key, "Number(") && ends_with(key, ")") && len(key) > 8 {
		plain_key := substring(key, 7, len(key) - 1)
		if has_key(lookup, plain_key) {
			return lookup[plain_key]
		}
	}
	return key
}

func resolve_lookup_array(values, lookup) {
	out := []
	value_idx := 0
	loop {
		if value_idx >= len(values) {
			break
		}

		value := values[value_idx]
		value_idx := value_idx + 1
		resolved := resolve_lookup(value, lookup, trim(to_string(value)))
		if len(trim(resolved)) > 0 {
			out = push(out, resolved)
		}
	}
	return out
}

func taxonomy_lookup_for(taxonomy_lookups, content_type, taxonomy_name) {
	tax_name := clean_slug(taxonomy_name)
	if tax_name == "untitled" {
		return {}
	}

	raw_content_type := trim(content_type)
	if len(raw_content_type) > 0 {
		content_slug := clean_slug(raw_content_type)
		if content_slug != "untitled" {
			specific_key := content_slug + ":" + tax_name
			if has_key(taxonomy_lookups, specific_key) {
				return taxonomy_lookups[specific_key]
			}
		}
	}

	global_key := "global:" + tax_name
	if has_key(taxonomy_lookups, global_key) {
		return taxonomy_lookups[global_key]
	}

	return {}
}

func is_reserved_frontmatter_key(key_name) {
	key := to_lower(trim(key_name))
	if key == "title" || key == "author" || key == "date" || key == "category" || key == "categories" || key == "tags" || key == "taxonomies" {
		return true
	}
	if key == "description" || key == "keywords" || key == "seo_title" || key == "seo_description" || key == "lang" || key == "canonical" {
		return true
	}
	if key == "featured_image" || key == "custom_url" || key == "template" || key == "draft" || key == "order" || key == "excerpt" || key == "nav_hide" {
		return true
	}
	return false
}

func taxonomy_terms_from_meta(meta, taxonomy_name) {
	tax_name := clean_slug(taxonomy_name)
	terms := []

	if has_key(meta, tax_name) {
		terms = merge_unique_strings(terms, to_string_array(meta[tax_name]))
	}

	if tax_name == "categories" && has_key(meta, "category") {
		category_single := trim(to_string(meta["category"]))
		if len(category_single) > 0 {
			terms = push_unique_string(terms, category_single)
		}
	}

	if has_key(meta, "taxonomies") && is_dict(meta["taxonomies"]) {
		taxonomies_map := meta["taxonomies"]
		if has_key(taxonomies_map, tax_name) {
			terms = merge_unique_strings(terms, to_string_array(taxonomies_map[tax_name]))
		}
	}

	return terms
}

func taxonomy_names_from_meta(meta, content_type, taxonomy_lookups) {
	names := ["categories", "tags"]

	if has_key(meta, "taxonomies") && is_dict(meta["taxonomies"]) {
		taxonomies_map := meta["taxonomies"]
		taxonomy_names := keys(taxonomies_map)
		i := 0
		loop {
			if i >= len(taxonomy_names) {
				break
			}
			taxonomy_name := taxonomy_names[i]
			i := i + 1

			normalized := clean_slug(taxonomy_name)
			if normalized != "untitled" {
				names = push_unique_string(names, normalized)
			}
		}
	}

	meta_keys := keys(meta)
	j := 0
	loop {
		if j >= len(meta_keys) {
			break
		}
		meta_key := meta_keys[j]
		j := j + 1

		# Fast path: reject reserved keys on the raw string before the much more
		# expensive clean_slug() regex work (hot path for large sites).
		if is_reserved_frontmatter_key(meta_key) {
			continue
		}

		normalized_key := clean_slug(meta_key)
		if normalized_key == "untitled" {
			continue
		}
		if is_reserved_frontmatter_key(normalized_key) {
			continue
		}

		lookup := taxonomy_lookup_for(taxonomy_lookups, content_type, normalized_key)
		if len(keys(lookup)) > 0 {
			names = push_unique_string(names, normalized_key)
		}
	}

	return names
}

# Render custom-taxonomy HTML, short-circuiting when the item cannot have any.
func custom_taxonomies_html(meta, content_type, taxonomy_lookups, excluded, has_custom_tax_lookups) {
	has_inline := is_dict(meta["taxonomies"]) && len(keys(meta["taxonomies"])) > 0
	if !has_custom_tax_lookups && !has_inline {
		return ""
	}
	return taxonomy_groups_html(resolve_taxonomy_groups(meta, content_type, taxonomy_lookups), excluded)
}

func resolve_taxonomy_groups(meta, content_type, taxonomy_lookups) {
	groups := {}
	taxonomy_names := taxonomy_names_from_meta(meta, content_type, taxonomy_lookups)

	i := 0
	loop {
		if i >= len(taxonomy_names) {
			break
		}
		taxonomy_name := taxonomy_names[i]
		i := i + 1

		raw_terms := taxonomy_terms_from_meta(meta, taxonomy_name)
		if len(raw_terms) == 0 {
			continue
		}

		lookup := taxonomy_lookup_for(taxonomy_lookups, content_type, taxonomy_name)
		resolved_terms := raw_terms
		if len(keys(lookup)) > 0 {
			resolved_terms = resolve_lookup_array(raw_terms, lookup)
		}

		resolved_terms = merge_unique_strings([], resolved_terms)
		if len(resolved_terms) > 0 {
			groups[taxonomy_name] = resolved_terms
		}
	}

	return groups
}

func taxonomy_terms_from_groups(groups, taxonomy_name) {
	tax_name := clean_slug(taxonomy_name)
	if has_key(groups, tax_name) {
		return to_string_array(groups[tax_name])
	}
	return []
}

func taxonomy_terms_html(terms) {
	if len(terms) == 0 {
		return ""
	}
	html := ""
	term_idx := 0
	loop {
		if term_idx >= len(terms) {
			break
		}

		term := terms[term_idx]
		term_idx := term_idx + 1
		html := html + "<span class=\"tag\">" + xml_escape(term) + "</span>"
	}
	return html
}

func taxonomy_label(taxonomy_name) {
	parts := split(clean_slug(taxonomy_name), "-")
	words := []
	i := 0
	loop {
		if i >= len(parts) {
			break
		}
		clean_part := trim(parts[i])
		i := i + 1

		if len(clean_part) == 0 {
			continue
		}
		if len(clean_part) == 1 {
			words = push(words, to_upper(clean_part))
		} else {
			words = push(words, to_upper(substring(clean_part, 0, 1)) + substring(clean_part, 1, len(clean_part)))
		}
	}
	return join(words, " ")
}

func taxonomy_groups_html(groups, excluded_taxonomies) {
	html := ""
	if !is_dict(groups) {
		return html
	}

	excluded_lookup := {}
	excluded_list := to_string_array(excluded_taxonomies)
	i := 0
	loop {
		if i >= len(excluded_list) {
			break
		}
		excluded_slug := clean_slug(excluded_list[i])
		if excluded_slug != "untitled" {
			excluded_lookup[excluded_slug] = true
		}
		i := i + 1
	}

	taxonomy_keys := sort(keys(groups))
	j := 0
	loop {
		if j >= len(taxonomy_keys) {
			break
		}

		taxonomy_name := taxonomy_keys[j]
		j := j + 1

		if has_key(excluded_lookup, taxonomy_name) {
			continue
		}

		terms := to_string_array(groups[taxonomy_name])
		if len(terms) == 0 {
			continue
		}

		label := taxonomy_label(taxonomy_name)
		html = html + "<div class=\"taxonomy-group taxonomy-" + clean_slug(taxonomy_name) + "\"><span class=\"taxonomy-label\">" + xml_escape(label) + ":</span> " + taxonomy_terms_html(terms) + "</div>"
	}

	return html
}

func load_taxonomy_lookups(content_root) {
	lookups := {}
	if !path_exists(content_root) || !path_is_dir(content_root) {
		return lookups
	}

	entries := sort(list_dir(content_root))
	i := 0
	loop {
		if i >= len(entries) {
			break
		}

		entry := entries[i]
		i := i + 1

		full_path := path_join(content_root, entry)
		if !path_is_file(full_path) {
			continue
		}

		lower_name := to_lower(entry)
		if !ends_with(lower_name, ".yml") && !ends_with(lower_name, ".yaml") {
			continue
		}
		if lower_name == "authors.yml" || lower_name == "authors.yaml" {
			continue
		}

		stem := entry
		if ends_with(lower_name, ".yaml") {
			stem = substring(entry, 0, len(entry) - 5)
		} else {
			stem = substring(entry, 0, len(entry) - 4)
		}

		taxonomy_lookup := load_lookup(full_path)
		if len(keys(taxonomy_lookup)) == 0 {
			continue
		}

		parts := split(stem, "-")
		if len(parts) < 2 {
			taxonomy_name := clean_slug(stem)
			if taxonomy_name != "untitled" {
				lookups["global:" + taxonomy_name] = taxonomy_lookup
			}
			continue
		}

		taxonomy_name := clean_slug(parts[len(parts) - 1])
		content_type_parts := []
		j := 0
		loop {
			if j >= len(parts) - 1 {
				break
			}
			content_type_parts = push(content_type_parts, parts[j])
			j := j + 1
		}

		content_type_name := clean_slug(join(content_type_parts, "-"))
		if taxonomy_name == "untitled" || content_type_name == "untitled" {
			continue
		}

		lookups[content_type_name + ":" + taxonomy_name] = taxonomy_lookup
	}

	return lookups
}

func tags_html(tags) {
	if len(tags) == 0 {
		return "<span class=\"tag\">General</span>"
	}
	html := ""
	tag_idx := 0
	loop {
		if tag_idx >= len(tags) {
			break
		}

		tag := tags[tag_idx]
		tag_idx := tag_idx + 1
		html := html + "<span class=\"tag\">" + html_escape(tag) + "</span>"
	}
	return html
}

func meta_terms(meta, taxonomy_name, lookup) {
	terms := []
	if has_key(meta, taxonomy_name) {
		terms = to_string_array(meta[taxonomy_name])
	}

	if taxonomy_name == "categories" && has_key(meta, "category") {
		single := trim(to_string(meta["category"]))
		if len(single) > 0 {
			terms = push(terms, single)
		}
	}

	if len(keys(lookup)) > 0 {
		terms = resolve_lookup_array(terms, lookup)
	}

	return terms
}

func meta_string(meta, key, fallback) {
	if is_dict(meta) && has_key(meta, key) {
		value := trim(to_string(meta[key]))
		if len(value) > 0 {
			return value
		}
	}
	return fallback
}

func build_page_title(seo_title, site_title) {
	base := trim(seo_title)
	if len(base) == 0 {
		base := trim(site_title)
	}
	site := trim(site_title)
	if len(site) == 0 || base == site {
		return base
	}
	return base + " | " + site
}

func route_absolute_url(site_url, route) {
	site := trim(site_url)
	if len(site) == 0 {
		return ""
	}
	if ends_with(site, "/") {
		site := substring(site, 0, len(site) - 1)
	}
	clean_route := normalize_route(route)
	if len(clean_route) == 0 {
		return site + "/"
	}
	return site + "/" + clean_route
}

func is_remote_media_path(path_value) {
	path_text := trim(path_value)
	if len(path_text) == 0 {
		return false
	}
	return starts_with(path_text, "http://") || starts_with(path_text, "https://") || starts_with(path_text, "//")
}

func strip_query_fragment(path_value) {
	clean := trim(path_value)
	if len(clean) == 0 {
		return ""
	}
	query_parts := split(clean, "?")
	clean = query_parts[0]
	fragment_parts := split(clean, "#")
	return trim(fragment_parts[0])
}

func normalize_image_extension(path_value) {
	clean := strip_query_fragment(path_value)
	if len(clean) == 0 {
		return ""
	}
	ext := to_lower(path_extension(clean))
	if ext == "jpeg" {
		return "jpg"
	}
	if ext == "tif" {
		return "tiff"
	}
	return ext
}

func has_supported_image_extension(path_value) {
	ext := normalize_image_extension(path_value)
	return ext == "jpg" || ext == "png" || ext == "gif" || ext == "webp" || ext == "bmp" || ext == "tiff"
}

func featured_image_output_base(source_key) {
	clean_source := strip_query_fragment(source_key)
	name := basename(clean_source)
	ext := path_extension(name)
	if len(ext) > 0 {
		name = replace(name, "." + ext, "")
	}
	name_slug := clean_slug(name)
	if name_slug == "untitled" {
		name_slug = "featured"
	}
	hash_value := md5(source_key)
	hash_short := hash_value
	if len(hash_short) > 12 {
		hash_short = substring(hash_short, 0, 12)
	}
	return name_slug + "-" + hash_short
}

func resolve_local_featured_image_source(path_value, source_file, settings) {
	source := trim(path_value)
	if len(source) == 0 {
		return ""
	}

	candidates := [source]
	if starts_with(source, "/") {
		rel_source := substring(source, 1, len(source))
		candidates = push(candidates, rel_source)
		candidates = push(candidates, path_join(settings["content"], rel_source))
		candidates = push(candidates, path_join(settings["assets"], rel_source))
	} else {
		candidates = push(candidates, path_join(dirname(source_file), source))
		candidates = push(candidates, path_join(settings["content"], source))
		candidates = push(candidates, path_join(settings["assets"], source))
		if starts_with(source, "assets/") {
			rel_from_assets := substring(source, len("assets/"), len(source))
			candidates = push(candidates, path_join(settings["assets"], rel_from_assets))
		}
	}

	candidate_idx := 0
	loop {
		if candidate_idx >= len(candidates) {
			break
		}

		candidate := candidates[candidate_idx]
		candidate_idx := candidate_idx + 1
		clean_candidate := trim(candidate)
		if len(clean_candidate) == 0 {
			continue
		}
		if path_exists(clean_candidate) && path_is_file(clean_candidate) {
			return clean_candidate
		}
	}

	return ""
}

func convert_or_copy_featured_image(local_source, source_key, settings) {
	if len(trim(local_source)) == 0 {
		return ""
	}

	images_dir := path_join(settings["output"], "images")
	ensure_dir(images_dir)

	ext := normalize_image_extension(local_source)
	if len(ext) == 0 {
		ext = "jpg"
	}

	base := featured_image_output_base(source_key)
	webp_rel := "images/" + base + ".webp"
	webp_abs := path_join(settings["output"], webp_rel)

	if path_exists(webp_abs) {
		return webp_rel
	}

	if ext == "webp" {
		copy_file(local_source, webp_abs)
		return webp_rel
	}

	converted := false
	try {
		image := load_image(local_source)
		save_result := image.save(webp_abs)
		if save_result == true && path_exists(webp_abs) {
			converted = true
		}
	} except err {
		converted = false
	}

	if converted {
		return webp_rel
	}

	fallback_rel := "images/" + base + "." + ext
	fallback_abs := path_join(settings["output"], fallback_rel)
	if !path_exists(fallback_abs) {
		copy_file(local_source, fallback_abs)
	}
	return fallback_rel
}

func process_remote_featured_image(source_url, settings) {
	if !parse_bool_value(settings["download_remote_images"], false) {
		return source_url
	}

	download_url := trim(source_url)
	if starts_with(download_url, "//") {
		download_url = "https:" + download_url
	}
	if !has_supported_image_extension(download_url) {
		return source_url
	}

	images_dir := path_join(settings["output"], "images")
	ensure_dir(images_dir)

	ext := normalize_image_extension(download_url)
	if len(ext) == 0 {
		ext = "jpg"
	}

	base := featured_image_output_base(download_url)
	webp_rel := "images/" + base + ".webp"
	webp_abs := path_join(settings["output"], webp_rel)
	if path_exists(webp_abs) {
		return webp_rel
	}

	download_rel := "images/" + base + "." + ext
	download_abs := path_join(settings["output"], download_rel)
	if !path_exists(download_abs) {
		try {
			image_bytes := http_get_binary(download_url)
			write_binary_file(download_abs, image_bytes)
		} except err {
			return source_url
		}
	}

	if ext == "webp" {
		return download_rel
	}

	converted := false
	try {
		image := load_image(download_abs)
		save_result := image.save(webp_abs)
		if save_result == true && path_exists(webp_abs) {
			converted = true
		}
	} except err {
		converted = false
	}

	if converted {
		return webp_rel
	}

	return download_rel
}

func process_featured_image_path(path_value, source_file, settings) {
	source := trim(path_value)
	if len(source) == 0 {
		return ""
	}

	if is_remote_media_path(source) {
		return process_remote_featured_image(source, settings)
	}

	local_source := resolve_local_featured_image_source(source, source_file, settings)
	if len(local_source) == 0 {
		return source
	}

	return convert_or_copy_featured_image(local_source, local_source, settings)
}

func resolve_media_url(path_value, relative_prefix) {
	media_path := trim(path_value)
	if len(media_path) == 0 {
		return ""
	}
	if starts_with(media_path, "http://") || starts_with(media_path, "https://") || starts_with(media_path, "//") || starts_with(media_path, "/") {
		return media_path
	}
	return relative_prefix + media_path
}

# Build an absolute media URL for social cards (og:image/twitter:image need
# absolute URLs). Falls back to empty when site_url is unknown.
func absolute_media_url(path_value, site_url) {
	media_path := trim(path_value)
	if len(media_path) == 0 {
		return ""
	}
	if starts_with(media_path, "http://") || starts_with(media_path, "https://") || starts_with(media_path, "//") {
		return media_path
	}
	site := trim(site_url)
	if len(site) == 0 {
		return ""
	}
	if ends_with(site, "/") {
		site = substring(site, 0, len(site) - 1)
	}
	if starts_with(media_path, "/") {
		return site + media_path
	}
	return site + "/" + media_path
}

func json_escape(value) {
	s := to_string(value)
	s = replace(s, "\\", "\\\\")
	s = replace(s, "\"", "\\\"")
	s = replace(s, "\n", "\\n")
	s = replace(s, "\r", "\\r")
	s = replace(s, "\t", "\\t")
	return s
}

func featured_image_html_tag(featured_image_url, title) {
	url := trim(featured_image_url)
	if len(url) == 0 {
		return ""
	}
	safe_url := xml_escape(url)
	safe_title := xml_escape(title)
	return "<img src=\"" + safe_url + "\" alt=\"Featured image for " + safe_title + "\" class=\"featured-image\" loading=\"lazy\" decoding=\"async\">"
}

func render_layout(layout_template, settings, route, page_title, meta_description, navigation, content, page_meta) {
	# Delegates to the native renderer (compiled once, byte-identical to the
	# previous interpreted body, which is preserved as render_layout_interpreted).
	return render_layout_native(layout_template, settings, route, page_title, meta_description, navigation, content, page_meta)
}

func render_layout_interpreted(layout_template, settings, route, page_title, meta_description, navigation, content, page_meta) {
	prefix := route_prefix(route)
	style_file := "assets/css/style.css"
	if settings["minify"] {
		style_file := "assets/css/style.min.css"
	}

	seo_title := meta_string(page_meta, "seo_title", page_title)
	seo_description := meta_string(page_meta, "seo_description", meta_description)
	if len(seo_description) == 0 {
		seo_description = trim(to_string(settings["site_tagline"]))
	}
	seo_keywords := meta_string(page_meta, "seo_keywords", "SSG, Static Site Generator")
	author_meta := meta_string(page_meta, "author", "Robert DeVore")
	lang := to_lower(meta_string(page_meta, "lang", "en"))
	if len(lang) == 0 {
		lang = "en"
	}

	site_url := trim(to_string(settings["site_url"]))
	canonical_url := meta_string(page_meta, "canonical", "")
	if len(canonical_url) == 0 {
		canonical_url = route_absolute_url(site_url, route)
	} else if len(site_url) > 0 && !starts_with(canonical_url, "http://") && !starts_with(canonical_url, "https://") && !starts_with(canonical_url, "//") {
		site_root := trim(site_url)
		if ends_with(site_root, "/") {
			site_root = substring(site_root, 0, len(site_root) - 1)
		}
		if starts_with(canonical_url, "/") {
			canonical_url = site_root + canonical_url
		} else {
			canonical_url = site_root + "/" + canonical_url
		}
	}

	og_url := canonical_url
	if len(og_url) == 0 {
		og_url = route_absolute_url(site_url, route)
	}

	raw_featured := meta_string(page_meta, "featured_image", "")
	# Social cards need absolute URLs; fall back to a prefix-relative path
	# only when no site_url is configured.
	social_image := absolute_media_url(raw_featured, site_url)
	if len(social_image) == 0 {
		social_image = resolve_media_url(raw_featured, prefix)
	}
	canonical_tag := ""
	if len(canonical_url) > 0 {
		canonical_tag = "<link rel=\"canonical\" href=\"" + xml_escape(canonical_url) + "\">"
	}
	og_image_tag := ""
	twitter_image_tag := ""
	if len(social_image) > 0 {
		safe_image := xml_escape(social_image)
		og_image_tag = "<meta property=\"og:image\" content=\"" + safe_image + "\">"
		twitter_image_tag = "<meta name=\"twitter:image\" content=\"" + safe_image + "\">"
	}

	og_type := to_lower(meta_string(page_meta, "og_type", "website"))
	if og_type != "article" {
		og_type = "website"
	}
	og_locale := replace(lang, "-", "_")
	if og_locale == "en" {
		og_locale = "en_US"
	}

	# article:published_time + datePublished for posts.
	published_iso := trim(meta_string(page_meta, "published_iso", ""))
	og_article_tags := ""
	if og_type == "article" {
		if len(published_iso) > 0 {
			og_article_tags = og_article_tags + "<meta property=\"article:published_time\" content=\"" + xml_escape(published_iso) + "\">"
		}
		if len(author_meta) > 0 {
			og_article_tags = og_article_tags + "<meta property=\"article:author\" content=\"" + xml_escape(author_meta) + "\">"
		}
	}

	# RSS autodiscovery only when an aux feed is actually produced.
	rss_link_tag := ""
	if len(site_url) > 0 && !settings["no_aux"] {
		rss_link_tag = "<link rel=\"alternate\" type=\"application/rss+xml\" title=\"" + html_escape(settings["site_title"]) + "\" href=\"" + prefix + "feed/index.xml\">"
	}

	# Lightweight SVG favicon generated alongside the site (see build_site).
	favicon_tag := "<link rel=\"icon\" type=\"image/svg+xml\" href=\"" + prefix + "favicon.svg\">"

	# JSON-LD structured data.
	schema_type := "WebSite"
	if og_type == "article" {
		schema_type = "BlogPosting"
	}
	json_ld_parts := [
		"\"@context\":\"https://schema.org\"",
		"\"@type\":\"" + schema_type + "\"",
		"\"headline\":\"" + json_escape(seo_title) + "\"",
		"\"name\":\"" + json_escape(seo_title) + "\"",
		"\"description\":\"" + json_escape(seo_description) + "\"",
		"\"url\":\"" + json_escape(og_url) + "\""
	]
	if len(social_image) > 0 {
		json_ld_parts = push(json_ld_parts, "\"image\":\"" + json_escape(social_image) + "\"")
	}
	if og_type == "article" {
		json_ld_parts = push(json_ld_parts, "\"author\":{\"@type\":\"Person\",\"name\":\"" + json_escape(author_meta) + "\"}")
		if len(published_iso) > 0 {
			json_ld_parts = push(json_ld_parts, "\"datePublished\":\"" + json_escape(published_iso) + "\"")
		}
	}
	json_ld_parts = push(json_ld_parts, "\"publisher\":{\"@type\":\"Organization\",\"name\":\"" + json_escape(settings["site_title"]) + "\"}")
	json_ld := "<script type=\"application/ld+json\">{" + join(json_ld_parts, ",") + "}</script>"

	computed_title := build_page_title(seo_title, settings["site_title"])
	safe_title := xml_escape(computed_title)
	safe_seo_title := xml_escape(seo_title)
	safe_description := xml_escape(seo_description)
	safe_keywords := xml_escape(seo_keywords)
	safe_author := xml_escape(author_meta)
	safe_og_url := xml_escape(og_url)
	safe_site_title := html_escape(settings["site_title"])
	safe_site_tagline := html_escape(settings["site_tagline"])

	html := apply_template(
		layout_template,
		{
			"site_name": safe_site_title,
			"site_title": safe_site_title,
			"site_tagline": safe_site_tagline,
			"navigation": navigation,
			"relative_path": prefix,
			"home_path": prefix + "index.html",
			"page_title": safe_title,
			"meta_description": safe_description,
			"seo_title": safe_seo_title,
			"seo_description": safe_description,
			"seo_keywords": safe_keywords,
			"author_meta": safe_author,
			"canonical_tag": canonical_tag,
			"og_url": safe_og_url,
			"og_type": og_type,
			"og_locale": xml_escape(og_locale),
			"og_image_tag": og_image_tag,
			"og_article_tags": og_article_tags,
			"twitter_image_tag": twitter_image_tag,
			"rss_link_tag": rss_link_tag,
			"favicon_tag": favicon_tag,
			"json_ld": json_ld,
			"lang": lang,
			"stylesheet_path": prefix + style_file,
			"content": content
		}
	)
	return html
}

func write_route_page(output_dir, route, html) {
	clean_route := normalize_route(route)
	if len(clean_route) == 0 {
		write_file(path_join(output_dir, "index.html"), html)
		return null
	}
	dir_route := substring(clean_route, 0, len(clean_route) - 1)
	full_dir := path_join(output_dir, dir_route)
	ensure_dir(full_dir)
	write_file(path_join(full_dir, "index.html"), html)
}

func write_route_alias(output_dir, route, enabled) {
	if !enabled {
		return null
	}
	clean_route := normalize_route(route)
	if len(clean_route) == 0 {
		return null
	}

	route_no_trailing := substring(clean_route, 0, len(clean_route) - 1)
	alias_path := path_join(output_dir, route_no_trailing + ".html")
	ensure_dir(dirname(alias_path))

	target_url := "/" + clean_route
	safe_target_url := xml_escape(target_url)
	alias_html := "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta http-equiv=\"refresh\" content=\"0; url=" + safe_target_url + "\"><link rel=\"canonical\" href=\"" + safe_target_url + "\"></head><body><main id=\"main-content\"><p>Redirecting to <a href=\"" + safe_target_url + "\">" + safe_target_url + "</a></p></main></body></html>"
	write_file(alias_path, alias_html)
}

func delete_tree(path) {
	if !path_exists(path) {
		return null
	}
	if path_is_file(path) {
		try {
			delete_file(path)
		} except err {
		}
		return null
	}

	entries := list_dir(path)
	entry_idx := 0
	loop {
		if entry_idx >= len(entries) {
			break
		}

		entry := entries[entry_idx]
		entry_idx := entry_idx + 1
		child := path_join(path, entry)
		if path_is_dir(child) {
			delete_tree(child)
		} else {
			try {
				delete_file(child)
			} except err {
			}
		}
	}
	try {
		os_rmdir(path)
	} except err {
	}
}

func copy_tree(src, dst) {
	if !path_exists(src) {
		return null
	}
	if path_is_file(src) {
		ensure_dir(dirname(dst))
		copy_file(src, dst)
		return null
	}

	ensure_dir(dst)
	entries := list_dir(src)
	entry_idx := 0
	loop {
		if entry_idx >= len(entries) {
			break
		}

		entry := entries[entry_idx]
		entry_idx := entry_idx + 1
		# Never publish OS/editor junk into the generated site.
		if entry == ".DS_Store" || entry == "Thumbs.db" {
			continue
		}
		src_path := path_join(src, entry)
		dst_path := path_join(dst, entry)
		if path_is_dir(src_path) {
			copy_tree(src_path, dst_path)
		} else {
			ensure_dir(dirname(dst_path))
			copy_file(src_path, dst_path)
		}
	}
}

func minify_text(text) {
	out := regex_replace(text, "\\s+", " ")
	out := regex_replace(out, "\\s*([{}:;,])\\s*", "$1")
	return trim(out)
}

func minify_assets_recursive(path) {
	if !path_exists(path) {
		return null
	}
	if path_is_dir(path) {
		entries := list_dir(path)
		entry_idx := 0
		loop {
			if entry_idx >= len(entries) {
				break
			}

			entry := entries[entry_idx]
			entry_idx := entry_idx + 1
			minify_assets_recursive(path_join(path, entry))
		}
		return null
	}

	file_name := basename(path)
	if ends_with(file_name, ".css") || ends_with(file_name, ".js") {
		if contains(file_name, ".min.") {
			return null
		}
		data := read_file(path)
		minified := minify_text(data)
		ext := path_extension(file_name)
		base := replace(file_name, "." + ext, "")
		min_name := base + ".min." + ext
		write_file(path_join(dirname(path), min_name), minified)
	}
}

func font_is_bundled(key) {
	return key == "bree serif" || key == "inter" || key == "quicksand" || key == "open sans"
}

func font_generic_fallback(key) {
	if key == "bree serif" {
		return "serif"
	}
	return "sans-serif"
}

func bundled_font_face_lines(family, key) {
	lines := []
	if key == "bree serif" {
		lines = push(lines, "@font-face { font-family: 'Bree Serif'; font-style: normal; font-weight: 400; font-display: swap; src: url('../fonts/bree-serif-latin-400.woff2') format('woff2'); }")
		lines = push(lines, "@font-face { font-family: 'Bree Serif'; font-style: normal; font-weight: 700; font-display: swap; src: url('../fonts/bree-serif-latin-400.woff2') format('woff2'); }")
	} else if key == "inter" {
		lines = push(lines, "@font-face { font-family: 'Inter'; font-style: normal; font-weight: 400; font-display: swap; src: url('../fonts/inter-latin-400.woff2') format('woff2'); }")
		lines = push(lines, "@font-face { font-family: 'Inter'; font-style: normal; font-weight: 700; font-display: swap; src: url('../fonts/inter-latin-700.woff2') format('woff2'); }")
	} else if key == "quicksand" {
		lines = push(lines, "@font-face { font-family: 'Quicksand'; font-style: normal; font-weight: 400; font-display: swap; src: url('../fonts/quicksand-latin.woff2') format('woff2'); }")
	} else if key == "open sans" {
		lines = push(lines, "@font-face { font-family: 'Open Sans'; font-style: normal; font-weight: 400; font-display: swap; src: url('../fonts/open-sans-latin.woff2') format('woff2'); }")
	}
	lines = push(lines, "")
	return lines
}

# Download a Google Font family (any family) and provision local woff2 files.
# Returns {"ok": bool, "lines": [...], "error": str}. Prefers the latin subset
# and caches downloads so repeat builds are deterministic and offline.
func try_download_google_font(family, output_fonts_dir, cache_fonts_dir) {
	out := {"ok": false, "lines": [], "error": ""}
	slug := clean_slug(family)
	api_family := replace(family, " ", "+")
	url := "https://fonts.googleapis.com/css2?family=" + api_family + ":wght@400;700&display=swap"
	ua := "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

	css := ""
	fetch_ok := false
	fetch_error := "request failed"
	try {
		request_result := http_request(url, {"headers": {"User-Agent": ua}})
		match request_result {
			case Ok(resp): {
				status := resp["status"]
				if status == 200 {
					css = to_string(resp["body"])
					fetch_ok = true
				} else {
					fetch_error = "HTTP " + to_string(status)
				}
			}
			case Err(request_err): {
				fetch_error = safe_error_text(request_err)
			}
		}
	} except err {
		fetch_error = safe_error_text(err)
	}
	if !fetch_ok {
		out["error"] = fetch_error
		return out
	}

	if len(css) == 0 || index_of(css, "@font-face") < 0 {
		out["error"] = "no @font-face in response"
		return out
	}

	# Pick one woff2 URL per weight, preferring the latin subset (U+0000 range).
	blocks := regex_split(css, "@font-face")
	chosen := {}
	bi := 0
	loop {
		if bi >= len(blocks) {
			break
		}
		block := blocks[bi]
		bi := bi + 1

		urls := regex_find_all(block, "https://[^)\\s\"']+\\.woff2")
		if len(urls) == 0 {
			continue
		}
		font_url := urls[0]
		weights := regex_find_all(block, "font-weight:[ ]*[0-9]+")
		weight := "400"
		if len(weights) > 0 {
			digits := regex_replace(weights[0], "[^0-9]", "")
			if len(digits) > 0 {
				weight = digits
			}
		}
		if index_of(block, "U+0000") >= 0 {
			chosen[weight] = font_url
		} else if has_key(chosen, weight) == 0 {
			chosen[weight] = font_url
		}
	}

	weight_keys := sort(keys(chosen))
	if len(weight_keys) == 0 {
		out["error"] = "no woff2 URLs found"
		return out
	}

	lines := []
	wi := 0
	loop {
		if wi >= len(weight_keys) {
			break
		}
		weight := weight_keys[wi]
		wi := wi + 1
		font_url := chosen[weight]
		file_name := slug + "-" + weight + ".woff2"
		output_path := path_join(output_fonts_dir, file_name)
		cache_path := path_join(cache_fonts_dir, file_name)

		ensured := false
		if path_exists(cache_path) {
			try {
				cached_bytes := read_binary_file(cache_path)
				write_binary_file(output_path, cached_bytes)
				ensured = true
			} except err {
				ensured = false
			}
		}
		if !ensured {
			try {
				downloaded := http_get_binary(font_url)
				write_binary_file(output_path, downloaded)
				ensure_dir(cache_fonts_dir)
				try {
					write_binary_file(cache_path, downloaded)
				} except cache_err {
				}
				ensured = true
			} except err {
				out["error"] = "download failed: " + safe_error_text(err)
				return out
			}
		}

		lines = push(lines, "@font-face { font-family: '" + family + "'; font-style: normal; font-weight: " + weight + "; font-display: swap; src: url('../fonts/" + file_name + "') format('woff2'); }")
	}
	lines = push(lines, "")

	out["ok"] = true
	out["lines"] = lines
	return out
}

# Resolve a requested font family to renderable @font-face lines. Bundled
# families are served offline; any other family is fetched from Google Fonts,
# falling back to a bundled default if the network/capability is unavailable.
func resolve_font_family(requested, default_family, settings, output_fonts_dir, cache_fonts_dir) {
	family := trim(to_string(requested))
	if len(family) == 0 {
		family = default_family
	}
	key := to_lower(family)
	if font_is_bundled(key) {
		return {"family": family, "fallback": font_generic_fallback(key), "lines": bundled_font_face_lines(family, key)}
	}

	result := try_download_google_font(family, output_fonts_dir, cache_fonts_dir)
	if result["ok"] {
		return {"family": family, "fallback": "sans-serif", "lines": result["lines"]}
	}

	warning := "Warning: could not provision Google Font '" + family + "' (" + result["error"] + "); falling back to '" + default_family + "'."
	warning = warning + " Font downloads need outbound network access (granted by default; in --untrusted mode add --allow-net-client)."
	print(warning)
	default_key := to_lower(default_family)
	return {"family": default_family, "fallback": font_generic_fallback(default_key), "lines": bundled_font_face_lines(default_family, default_key)}
}

func generate_fonts_css(settings) {
	fonts := to_string_array(settings["fonts"])
	title_font := "Bree Serif"
	body_font := "Inter"
	if len(fonts) > 0 {
		candidate_title := trim(to_string(fonts[0]))
		if len(candidate_title) > 0 {
			title_font = candidate_title
		}
	}
	if len(fonts) > 1 {
		candidate_body := trim(to_string(fonts[1]))
		if len(candidate_body) > 0 {
			body_font = candidate_body
		}
	}

	css_dir := path_join(settings["output"], "assets/css")
	ensure_dir(css_dir)
	output_fonts_dir := path_join(settings["output"], "assets/fonts")
	ensure_dir(output_fonts_dir)
	# Downloaded Google Fonts are cached outside the asset tree so repeat builds
	# stay offline and deterministic without polluting source-controlled assets.
	cache_fonts_dir := ".cache/fonts"

	resolved_title := resolve_font_family(title_font, "Bree Serif", settings, output_fonts_dir, cache_fonts_dir)
	resolved_body := resolve_font_family(body_font, "Inter", settings, output_fonts_dir, cache_fonts_dir)

	lines := ["/* Generated by Kujo SSG */", ""]
	emitted := {}
	slots := [resolved_title, resolved_body]
	slot_idx := 0
	loop {
		if slot_idx >= len(slots) {
			break
		}
		slot := slots[slot_idx]
		slot_idx := slot_idx + 1
		slot_key := to_lower(slot["family"])
		if has_key(emitted, slot_key) {
			continue
		}
		emitted[slot_key] = true
		slot_lines := slot["lines"]
		line_idx := 0
		loop {
			if line_idx >= len(slot_lines) {
				break
			}
			lines = push(lines, slot_lines[line_idx])
			line_idx := line_idx + 1
		}
	}

	title_css_family := resolved_title["family"]
	body_css_family := resolved_body["family"]
	title_fallback := resolved_title["fallback"]
	body_fallback := resolved_body["fallback"]

	lines = push(lines, "body { font-family: '" + body_css_family + "', " + body_fallback + "; }")
	lines = push(lines, "h1, h2, h3, h4, h5, h6, .title-font { font-family: '" + title_css_family + "', " + title_fallback + "; }")
	lines = push(lines, ".font-body-light { font-family: '" + body_css_family + "', " + body_fallback + "; font-weight: 300; }")
	lines = push(lines, ".font-heading-bold { font-family: '" + title_css_family + "', " + title_fallback + "; font-weight: 700; }")

	write_file(path_join(css_dir, "fonts.css"), join(lines, "\n") + "\n")
}

func pagination_page_link(page, current_page, base_path) {
	route := base_path
	if page != 1 {
		route = base_path + "page/" + to_string(page) + "/"
	}
	if page == current_page {
		return "<strong aria-current=\"page\">" + to_string(page) + "</strong>"
	}
	return "<a href=\"/" + route + "\">" + to_string(page) + "</a>"
}

# Windowed pagination (first … current-2..current+2 … last). O(1) per page
# instead of O(total_pages), which keeps large-site listing generation linear
# and produces a usable control instead of a thousand-link bar.
func build_pagination_links(current_page, total_pages, base_path) {
	if total_pages <= 1 {
		return ""
	}
	html := "<nav class=\"pagination\" aria-label=\"Pagination\">"

	if current_page > 1 {
		prev_route := base_path
		if current_page - 1 != 1 {
			prev_route = base_path + "page/" + to_string(current_page - 1) + "/"
		}
		html = html + "<a href=\"/" + prev_route + "\" rel=\"prev\">Previous</a>"
	}

	delta := 2
	window_start := current_page - delta
	if window_start < 2 {
		window_start = 2
	}
	window_end := current_page + delta
	if window_end > total_pages - 1 {
		window_end = total_pages - 1
	}

	html = html + pagination_page_link(1, current_page, base_path)
	if window_start > 2 {
		html = html + "<span class=\"pagination-gap\" aria-hidden=\"true\">…</span>"
	}
	page := window_start
	loop {
		if page > window_end {
			break
		}
		html = html + pagination_page_link(page, current_page, base_path)
		page = page + 1
	}
	if window_end < total_pages - 1 {
		html = html + "<span class=\"pagination-gap\" aria-hidden=\"true\">…</span>"
	}
	html = html + pagination_page_link(total_pages, current_page, base_path)

	if current_page < total_pages {
		next_route := base_path + "page/" + to_string(current_page + 1) + "/"
		html = html + "<a href=\"/" + next_route + "\" rel=\"next\">Next</a>"
	}

	html = html + "</nav>"
	return html
}

func listing_card_media_url(path_value) {
	media := trim(path_value)
	if len(media) == 0 {
		return ""
	}
	loop {
		if starts_with(media, "../") {
			media := substring(media, 3, len(media))
			continue
		}
		if starts_with(media, "./") {
			media := substring(media, 2, len(media))
			continue
		}
		break
	}
	if starts_with(media, "http://") || starts_with(media, "https://") || starts_with(media, "//") || starts_with(media, "/") {
		return media
	}
	return "/" + media
}

func listing_card_tags_html(terms) {
	if !is_array(terms) || len(terms) == 0 {
		return ""
	}

	html := ""
	count := 0
	term_idx := 0
	loop {
		if term_idx >= len(terms) {
			break
		}

		term := terms[term_idx]
		term_idx := term_idx + 1
		if count >= 3 {
			break
		}
		safe_term := html_escape(to_string(term))
		html := html + "<span class=\"tag listing-tag\">" + safe_term + "</span>"
		count := count + 1
	}
	return html
}

func listing_card_html(route, title, excerpt, featured_image, terms, action_label) {
	# Delegates to the native renderer (byte-identical to listing_card_html_interpreted).
	return render_listing_card(route, title, excerpt, featured_image, terms, action_label)
}

func listing_card_html_interpreted(route, title, excerpt, featured_image, terms, action_label) {
	safe_href := xml_escape(route_to_path(route))
	safe_title := html_escape(title)
	safe_excerpt := html_escape(excerpt)

	media_url := listing_card_media_url(featured_image)
	safe_media_url := xml_escape(media_url)
	title_attr := xml_escape(title)

	tags_html := listing_card_tags_html(terms)
	tags_block := ""
	if len(tags_html) > 0 {
		tags_block = "<div class=\"listing-card-tags\">" + tags_html + "</div>"
	}

	button_text := trim(action_label)
	if len(button_text) == 0 {
		button_text = "Read More"
	}
	safe_button_text := html_escape(button_text)

	media_block := "<a class=\"listing-card-image-link\" href=\"" + safe_href + "\"><span class=\"listing-card-image-placeholder\" aria-hidden=\"true\"></span></a>"
	if len(media_url) > 0 {
		media_block = "<a class=\"listing-card-image-link\" href=\"" + safe_href + "\"><img src=\"" + safe_media_url + "\" alt=\"Featured image for " + title_attr + "\" class=\"listing-card-image\" loading=\"lazy\" decoding=\"async\"></a>"
	}

	return "<li class=\"listing-card\">" + media_block + "<div class=\"listing-card-body\">" + tags_block + "<h2 class=\"listing-card-title\"><a href=\"" + safe_href + "\" class=\"text-links\">" + safe_title + "</a></h2><p class=\"listing-card-excerpt\">" + safe_excerpt + "</p><a href=\"" + safe_href + "\" class=\"listing-card-button\">" + safe_button_text + "</a></div></li>"
}

func pad2(n) {
	s := to_string(n)
	if len(s) < 2 {
		return "0" + s
	}
	return s
}

func month_index_from_name(name) {
	key := to_lower(trim(name))
	if len(key) > 3 {
		key = substring(key, 0, 3)
	}
	abbr := ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
	i := 0
	loop {
		if i >= len(abbr) {
			break
		}
		if abbr[i] == key {
			return i + 1
		}
		i := i + 1
	}
	return 0
}

# Parse a frontmatter date into normalized parts. Accepts ISO (YYYY-MM-DD,
# optionally with a T/space time), YYYY/MM/DD, MM/DD/YYYY, "Month DD, YYYY",
# and "DD Month YYYY". Returns a dict; "valid" is false for unparseable input.
func parse_post_date(raw) {
	invalid := {"valid": false, "year": 0, "month": 0, "day": 0, "sort_key": 0, "display": "", "rfc822": "", "iso": ""}
	text := trim(to_string(raw))
	if len(text) == 0 {
		return invalid
	}

	year := 0
	month := 0
	day := 0

	normalized := replace(text, ",", " ")
	raw_tokens := split(normalized, " ")
	tokens := []
	ti := 0
	loop {
		if ti >= len(raw_tokens) {
			break
		}
		tk := trim(raw_tokens[ti])
		ti := ti + 1
		if len(tk) > 0 {
			tokens = push(tokens, tk)
		}
	}
	if len(tokens) == 0 {
		return invalid
	}

	first := tokens[0]
	if index_of(first, "-") >= 0 {
		date_only := split(first, "T")[0]
		parts := split(date_only, "-")
		if len(parts) >= 3 {
			year = parse_int_value(parts[0], 0)
			month = parse_int_value(parts[1], 0)
			day = parse_int_value(parts[2], 0)
		}
	} else if index_of(first, "/") >= 0 {
		parts := split(first, "/")
		if len(parts) >= 3 {
			if len(parts[0]) == 4 {
				year = parse_int_value(parts[0], 0)
				month = parse_int_value(parts[1], 0)
				day = parse_int_value(parts[2], 0)
			} else {
				month = parse_int_value(parts[0], 0)
				day = parse_int_value(parts[1], 0)
				year = parse_int_value(parts[2], 0)
			}
		}
	} else {
		leading_month := month_index_from_name(tokens[0])
		if leading_month > 0 && len(tokens) >= 3 {
			month = leading_month
			day = parse_int_value(tokens[1], 0)
			year = parse_int_value(tokens[2], 0)
		} else if len(tokens) >= 3 {
			day = parse_int_value(tokens[0], 0)
			month = month_index_from_name(tokens[1])
			year = parse_int_value(tokens[2], 0)
		}
	}

	if year <= 0 || month < 1 || month > 12 || day < 1 || day > 31 {
		return invalid
	}

	full_names := ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
	abbr_names := ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
	display := full_names[month - 1] + " " + to_string(day) + ", " + to_string(year)

	# Sakamoto's algorithm for day-of-week (0 = Sunday).
	sakamoto := [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
	y := year
	if month < 3 {
		y = y - 1
	}
	dow := (y + y / 4 - y / 100 + y / 400 + sakamoto[month - 1] + day) % 7
	dow_names := ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
	rfc822 := dow_names[dow] + ", " + pad2(day) + " " + abbr_names[month - 1] + " " + to_string(year) + " 00:00:00 +0000"

	return {
		"valid": true,
		"year": year,
		"month": month,
		"day": day,
		"sort_key": year * 10000 + month * 100 + day,
		"display": display,
		"rfc822": rfc822,
		"iso": to_string(year) + "-" + pad2(month) + "-" + pad2(day)
	}
}

func post_sort_before(a, b, sort_by) {
	if sort_by == "title" {
		return to_lower(a["title"]) < to_lower(b["title"])
	}
	if sort_by == "author" {
		return to_lower(a["author"]) < to_lower(b["author"])
	}
	if sort_by == "order" {
		return a["order"] < b["order"]
	}
	# Default date sort: newest first, by normalized numeric key.
	return a["date_sort_key"] > b["date_sort_key"]
}

func sort_posts(posts, sort_by) {
	sorted_posts := posts
	n := len(sorted_posts)
	i := 1
	loop {
		if i >= n {
			break
		}

		current := sorted_posts[i]
		j := i
		loop {
			if j <= 0 {
				break
			}

			prev := sorted_posts[j - 1]
			if !post_sort_before(current, prev, sort_by) {
				break
			}

			sorted_posts[j] = prev
			j := j - 1
		}

		sorted_posts[j] = current
		i := i + 1
	}
	return sorted_posts
}

# --- Scale-friendly accumulation helpers -------------------------------------
# Kujo arrays are copy-on-write, so `arr = push(arr, x)` in a hot loop is O(n^2)
# and an in-language sort is O(n^3). For large sites we instead accumulate
# records into a string (string concat is amortized O(n)), build the array in a
# single `split` call, and sort once with the native O(n log n) `sort`.

func pad_number(value, width) {
	s := to_string(value)
	loop {
		if len(s) >= width {
			break
		}
		s = "0" + s
	}
	return s
}

# Lexicographic sort prefix so a single native string sort yields the requested
# order. Date is descending (newest first); title/author ascending; order asc.
func post_sort_prefix(sort_by, date_sort_key, title, author, order) {
	if sort_by == "title" {
		return to_lower(title)
	}
	if sort_by == "author" {
		return to_lower(author)
	}
	if sort_by == "order" {
		return pad_number(order, 8)
	}
	return pad_number(99999999 - date_sort_key, 8)
}

# changefreq/priority + lastmod for a single sitemap entry. Emitted incrementally
# as a string instead of accumulating a routes array.
func sitemap_url_entry(site_url, route, lastmod_iso, blog_prefix) {
	url := site_url + "/"
	if len(route) > 0 {
		url = site_url + "/" + route
	}

	changefreq := "monthly"
	priority := "0.7"
	if len(route) == 0 {
		changefreq = "weekly"
		priority = "1.0"
	} else if len(blog_prefix) > 0 && route == blog_prefix {
		changefreq = "daily"
		priority = "0.9"
	} else if len(blog_prefix) > 0 && starts_with(route, blog_prefix + "page/") {
		changefreq = "weekly"
		priority = "0.6"
	} else if len(blog_prefix) > 0 && starts_with(route, blog_prefix) {
		changefreq = "monthly"
		priority = "0.8"
	} else if starts_with(route, "page/") {
		changefreq = "weekly"
		priority = "0.6"
	}

	entry := "  <url>\n    <loc>" + xml_escape(url) + "</loc>\n"
	clean_lastmod := trim(to_string(lastmod_iso))
	if len(clean_lastmod) == 10 {
		entry = entry + "    <lastmod>" + xml_escape(clean_lastmod) + "</lastmod>\n"
	}
	entry = entry + "    <changefreq>" + changefreq + "</changefreq>\n    <priority>" + priority + "</priority>\n  </url>\n"
	return entry
}

# Parse a tab-delimited post index record back into a dict for rendering.
func parse_post_record(line) {
	f := split(line, "\t")
	record := {"route": "", "title": "", "excerpt": "", "featured_image": "", "tags": [], "date_rfc822": "", "date_iso": ""}
	if len(f) > 1 {
		record["route"] = f[1]
	}
	if len(f) > 2 {
		record["title"] = f[2]
	}
	if len(f) > 3 {
		record["excerpt"] = f[3]
	}
	if len(f) > 4 {
		record["featured_image"] = f[4]
	}
	if len(f) > 5 && len(f[5]) > 0 {
		record["tags"] = split(f[5], ",")
	}
	if len(f) > 6 {
		record["date_rfc822"] = f[6]
	}
	if len(f) > 7 {
		record["date_iso"] = f[7]
	}
	return record
}

func create_sample_config(format_name) {
	fmt := to_lower(trim(format_name))
	if fmt != "yaml" && fmt != "json" && fmt != "yml" {
		fmt := "yml"
	}
	sample := {
		"site_url": "https://example.com",
		"site_title": "Kujo SSG Starter Site",
		"site_tagline": "A complete starter that shows pages, posts, custom types, and taxonomy workflows.",
		"output": "output",
		"content": "content",
		"templates": "templates",
		"assets": "assets",
		"blog_slug": "blog",
		"posts_at_root": false,
		"posts_per_page": 2,
		"sort_by": "date",
		"fonts": ["Bree Serif", "Inter"],
		"robots": "public",
		"llms": "public",
		"minify": false,
		"download_remote_images": false,
		"watch": false
	}

	if fmt == "json" {
		write_file("kujo-ssg.json", to_json(sample))
		return "kujo-ssg.json"
	}

	yaml_file := "kujo-ssg." + fmt
	write_file(yaml_file, to_yaml(sample))
	return yaml_file
}

