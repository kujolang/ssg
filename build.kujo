func print_help() {
	print("Usage: kujo run ./build.kujo [options]")
	print("")
	print("Site build options:")
	print("  --output <dir>                Output directory (default: output)")
	print("  --content <dir>               Content directory (default: content)")
	print("  --templates <dir>             Templates directory (default: templates)")
	print("  --assets <dir>                Assets directory (default: assets)")
	print("  --posts-per-page <n>          Pagination size (default: 5)")
	print("  --sort-by <date|title|author|order>")
	print("  --fonts <comma,list>          Google fonts list")
	print("  --site-title <text>")
	print("  --site-tagline <text>")
	print("  --site-url <url>")
	print("  --robots <public|private>")
	print("  --llms <public|private>")
	print("  --watch                       Reserved (not implemented)")
	print("  --minify                      Generate minified CSS/JS")
	print("  --download-remote-images      Download remote featured images")
	print("  --blog-slug <slug>            Blog root slug (default: blog)")
	print("  --init <yml|yaml|json>        Bootstrap starter project")
	print("  --version                     Print version and exit")
	print("  --help                        Show this help and exit")
	print("")
	print("Benchmark compatibility options:")
	print("  --no-index                    Skip index/blog listing pages")
	print("  --no-aux                      Skip feed/sitemap/robots/llms generation")
}

