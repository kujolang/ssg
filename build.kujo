# Kujo Static Site Generator
# Native Kujo implementation with full parity-focused feature set.

VERSION := "1.2.0"

func print_lines(lines) {
	i := 0
	loop {
		if i >= len(lines) {
			break
		}

		print(lines[i])
		i := i + 1
	}
}

print_lines([
	"╔════════════════════════════════════════════════╗",
	"║        Kujo Static Site Generator              ║",
	"╚════════════════════════════════════════════════╝",
	""
])

func print_help() {
	print_lines([
		"Usage: kujo run ./build.kujo [options]",
		"",
		"Site build options:",
		"  --output <dir>                Output directory (default: output)",
		"  --content <dir>               Content directory (default: content)",
		"  --templates <dir>             Templates directory (default: templates)",
		"  --assets <dir>                Assets directory (default: assets)",
		"  --posts-per-page <n>          Pagination size (default: 5)",
		"  --sort-by <date|title|author|order>",
		"  --fonts <comma,list>          Google fonts list",
		"  --site-title <text>",
		"  --site-tagline <text>",
		"  --site-url <url>",
		"  --robots <public|private>",
		"  --llms <public|private>",
		"  --watch                       Reserved (not implemented)",
		"  --minify                      Generate minified CSS/JS",
		"  --download-remote-images      Download remote featured images",
		"  --drafts                      Include draft content (preview builds)",
		"  --blog-slug <slug>            Blog root slug (default: blog)",
		"  --posts-at-root               Keep post permalinks at /<slug>/",
		"  --init <yml|yaml|json>        Bootstrap starter project",
		"  --version                     Print version and exit",
		"  --help                        Show this help and exit",
		"",
		"Benchmark compatibility options:",
		"  --no-index                    Skip index/blog listing pages",
		"  --no-aux                      Skip feed/sitemap/robots/llms generation",
		"  --no-aliases                  Skip flat .html redirect aliases (clean URLs only)"
	])
}

