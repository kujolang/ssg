{
  "schema": "kujo.ability/v1",
  "id": "kujo.ssg.site.validate",
  "version": "1.0.0",
  "description": "Validate generated SSG output against the repository contract.",
  "input_schema": {
    "type": "object",
    "properties": { "output": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["valid", "output"],
    "properties": { "valid": { "type": "boolean" }, "output": { "type": "string" } },
    "additionalProperties": false
  },
  "effects": [{ "kind": "read", "resource": "kujo.ssg.generated-output" }],
  "idempotency": { "mode": "intrinsic" }
}
